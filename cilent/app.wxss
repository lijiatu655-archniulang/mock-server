/**
 * 新源村情通 · 全局样式
 * 视觉基调：政务红 + 暖白底 + 克制的金橙点缀
 */

page {
  --c-red: #C4161C;
  --c-red-deep: #8E0F14;
  --c-red-bright: #E23B32;
  --c-red-soft: #FBEBEB;
  --c-orange: #E8641B;
  --c-orange-soft: #FDF1E8;
  --c-gold: #C99437;
  --c-gold-soft: #FAF3E3;
  --c-ink: #202124;
  --c-ink-2: #4B4F55;
  --c-muted: #8A8D93;
  --c-faint: #B3B0AD;
  --c-line: #EDE7E4;
  --c-bg: #F6F2F0;
  --c-white: #FFFFFF;
  --shadow-card: 0 8rpx 30rpx rgba(94, 42, 37, 0.06);
  --shadow-float: 0 16rpx 44rpx rgba(142, 15, 20, 0.16);

  min-height: 100%;
  background: #F6F2F0;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: 0;
}

button[disabled] {
  color: inherit;
  background: transparent;
}

image {
  display: block;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.page-tabbar {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-flat {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #F1EBE8;
}

/* ---------- 版块标题 ---------- */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #202124;
  letter-spacing: 0.5rpx;
}

.section-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #E23B32, #A8111A);
}

.section-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #A19A96;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8A8D93;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  white-space: nowrap;
}

.tag-red {
  color: #C4161C;
  background: #FBEBEB;
}

.tag-orange {
  color: #C2571A;
  background: #FDF1E8;
}

.tag-gold {
  color: #9A6C1F;
  background: #FAF3E3;
}

.tag-gray {
  color: #8A8D93;
  background: #F4F1EF;
}

.tag-solid {
  color: #FFFFFF;
  background: #C4161C;
}

.tag-line {
  color: #C4161C;
  border: 1rpx solid rgba(196, 22, 28, 0.28);
  background: transparent;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.btn-primary {
  color: #FFFFFF;
  background: linear-gradient(135deg, #D01D22 0%, #A8111A 100%);
  box-shadow: 0 10rpx 24rpx rgba(196, 22, 28, 0.22);
}

.btn-ghost {
  color: #C4161C;
  background: #FFFFFF;
  border: 1rpx solid rgba(196, 22, 28, 0.32);
}

.btn-muted {
  color: #FFFFFF;
  background: #CFC9C5;
}

.btn-hover {
  opacity: 0.88;
  transform: translateY(1rpx);
}

/* ---------- 状态 ---------- */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.state-emoji {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: #F7F1EE;
  color: #C4161C;
  font-size: 44rpx;
  line-height: 96rpx;
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4B4F55;
}

.state-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8A8D93;
}

.state-action {
  margin-top: 28rpx;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.3);
  color: #C4161C;
  font-size: 24rpx;
  line-height: 62rpx;
}

/* ---------- 骨架屏 ---------- */
.skeleton {
  background: linear-gradient(90deg, #F1ECE9 25%, #FAF7F5 37%, #F1ECE9 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ---------- 通用修饰 ---------- */
.line-1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.line-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.line-3 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 2rpx solid #B3B0AD;
  border-bottom: 2rpx solid #B3B0AD;
  transform: rotate(-45deg);
}

.arrow-red {
  border-color: #C4161C;
}

.divider {
  height: 1rpx;
  background: #F1EBE8;
}

.press {
  opacity: 0.9;
}

.fade-in {
  animation: fadeIn 0.32s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
