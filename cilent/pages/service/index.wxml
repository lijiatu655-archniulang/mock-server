<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="page service-page">
  <view class="service-hero">
    <view class="hero-glow"></view>
    <view class="hero-kicker">
      <view class="kicker-dot"></view>
      <text>{{i18n.t('新源村 · 生活服务', lang)}}</text>
    </view>
    <view class="hero-title">{{i18n.t('便民服务', lang)}}</view>
    <view class="hero-sub">{{i18n.t('水电气暖、家门口的工作、村里的事，都能找到人', lang)}}</view>
    <view class="hero-stats">
      <view class="hero-stat">
        <view class="hero-num">{{stats.services}}</view>
        <view class="hero-label">{{i18n.t('服务电话', lang)}}</view>
      </view>
      <view class="hero-line"></view>
      <view class="hero-stat">
        <view class="hero-num">{{stats.jobs}}</view>
        <view class="hero-label">{{i18n.t('在招岗位', lang)}}</view>
      </view>
      <view class="hero-line"></view>
      <view class="hero-stat">
        <view class="hero-num">{{stats.teas}}</view>
        <view class="hero-label">{{i18n.t('村里议事', lang)}}</view>
      </view>
    </view>
  </view>

  <view class="service-tabs">
    <view
      class="service-tab {{tab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onTabTap"
      hover-class="press"
    >
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-main">
        <view class="tab-name">{{lang === 'ko' ? item.nameKo : item.name}}</view>
        <view class="tab-sub">{{lang === 'ko' ? item.subKo : item.sub}}</view>
      </view>
      <view class="tab-count">{{item.count}}</view>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="service-card card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-block" style="width:40%;height:28rpx;"></view>
      <view class="sk-block" style="width:80%;height:24rpx;margin-top:16rpx;"></view>
    </view>
  </block>

  <view class="state-box card" wx:elif="{{error}}">
    <view class="state-emoji">!</view>
    <view class="state-title">{{i18n.t('便民服务没有加载出来', lang)}}</view>
    <view class="state-desc">{{error}}</view>
    <view class="state-action" bindtap="retry">{{i18n.t('重新加载', lang)}}</view>
  </view>

  <block wx:else>
    <view class="state-box card" wx:if="{{tab === 'directory' && !directoryGroups.length}}">
      <view class="state-emoji">{{i18n.t('空', lang)}}</view>
      <view class="state-title">{{i18n.t('暂时没有服务电话', lang)}}</view>
      <view class="state-desc">{{i18n.t('可以拨打村党群服务中心电话 0432-64216888 咨询。', lang)}}</view>
    </view>
    <view class="state-box card" wx:elif="{{tab === 'jobs' && !jobs.length}}">
      <view class="state-emoji">{{i18n.t('空', lang)}}</view>
      <view class="state-title">{{i18n.t('暂时没有招聘岗位', lang)}}</view>
      <view class="state-desc">{{i18n.t('有新岗位会第一时间发布，也可以到村党群服务中心登记求职意向。', lang)}}</view>
    </view>
    <view class="state-box card" wx:elif="{{tab === 'tea' && !teas.length}}">
      <view class="state-emoji">{{i18n.t('空', lang)}}</view>
      <view class="state-title">{{i18n.t('暂时没有议题', lang)}}</view>
      <view class="state-desc">{{i18n.t('下一场奶茶会正在筹备，欢迎到村里提议题。', lang)}}</view>
    </view>

    <!-- 服务黄页 -->
    <block wx:if="{{tab === 'directory'}}">
      <view class="group" wx:for="{{directoryGroups}}" wx:key="name" wx:for-item="group">
        <view class="group-head">
          <view class="group-name">{{group.name}}</view>
          <view class="group-count">{{group.list.length}} 个服务</view>
        </view>
        <view class="service-card card" wx:for="{{group.list}}" wx:key="id" wx:for-item="item">
          <view class="service-row">
            <view class="service-icon" style="background:{{item.tint}};color:{{item.color}};">{{item.icon}}</view>
            <view class="service-main">
              <view class="service-name">{{item.name}}</view>
              <view class="service-desc">{{item.desc}}</view>
              <view class="service-hours">{{item.hours}}</view>
            </view>
            <view class="call-btn" data-phone="{{item.phone}}" bindtap="onCall" hover-class="press">
              <image class="call-icon" src="/assets/icons/icon-phone.png" mode="aspectFit"></image>
              <text>{{i18n.t('拨打', lang)}}</text>
            </view>
          </view>
          <view class="service-phone-row">
            <text class="service-phone">{{item.phoneDisplay}}</text>
            <text class="service-hint">{{i18n.t('工作日可拨打', lang)}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 就业招聘 -->
    <block wx:elif="{{tab === 'jobs'}}">
      <view class="job-card card" wx:for="{{jobs}}" wx:key="id">
        <view class="job-top">
          <view class="job-main">
            <view class="job-title">{{item.title}}</view>
            <view class="job-company">{{item.company}}</view>
          </view>
          <view class="job-salary">{{item.salary}}</view>
        </view>
        <view class="job-tags">
          <text class="job-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        <view class="job-desc">{{item.desc}}</view>
        <view class="job-meta">
          <text>招聘 {{item.count}} 人</text>
          <text class="meta-dot">·</text>
          <text>{{item.location}}</text>
          <text class="meta-dot">·</text>
          <text>截止 {{item.deadline}}</text>
        </view>
        <view class="job-foot">
          <text class="job-contact">联系人电话 {{item.contactDisplay}}</text>
          <view class="call-btn small" data-phone="{{item.contact}}" bindtap="onCall" hover-class="press">{{i18n.t('打电话', lang)}}</view>
        </view>
      </view>
    </block>

    <!-- 线上奶茶会 -->
    <block wx:else>
      <view class="tea-card card" wx:for="{{teas}}" wx:key="id">
        <view class="tea-top">
          <view class="tea-status {{item.status === '报名中' ? 'open' : 'end'}}">{{item.status}}</view>
          <view class="tea-date">{{item.date}}</view>
        </view>
        <view class="tea-title">{{item.title}}</view>
        <view class="tea-location">地点：{{item.location}}</view>
        <view class="tea-progress">
          <view class="progress-track">
            <view class="progress-fill" style="width:{{item.percent}}%;"></view>
          </view>
          <text class="progress-text">已报名 {{item.joined}}/{{item.total}}</text>
        </view>
        <view class="tea-summary">{{item.summary}}</view>
        <view class="tea-agenda">
          <view class="agenda-item" wx:for="{{item.agenda}}" wx:key="*this" wx:for-item="topic" wx:for-index="topicIndex">
            <text class="agenda-index">{{topicIndex + 1}}</text>
            <text>{{topic}}</text>
          </view>
        </view>
        <view class="tea-foot">
          <text class="tea-host">{{item.host}}</text>
          <view
            class="signup-btn {{item.signed ? 'signed' : ''}} {{item.status !== '报名中' ? 'disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSignup"
            hover-class="press"
          >{{item.status !== '报名中' ? i18n.t('已结束', lang) : item.signed ? i18n.t('已报名', lang) : i18n.t('我要报名', lang)}}</view>
        </view>
      </view>
    </block>
  </block>

  <view class="service-footer">
    <text>{{i18n.t('信息由新源村党群服务中心整理', lang)}}</text>
    <text>{{i18n.t('如需新增服务电话，请联系 0432-64216888', lang)}}</text>
  </view>
</view>
