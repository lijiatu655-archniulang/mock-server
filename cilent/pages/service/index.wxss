.service-page {
  background: #F6F2F0;
}

.service-head {
  padding: 34rpx 30rpx 24rpx;
  background: linear-gradient(180deg, #FFF8F3 0%, #F6F2F0 100%);
}

.head-kicker {
  color: #A06A4C;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.head-title {
  margin-top: 8rpx;
  color: #24262A;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 6rpx;
  color: #9A938E;
  font-size: 22rpx;
  line-height: 1.6;
}

.tab-bar {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #EFE8E4;
}

.tab-item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  color: #7E8288;
  font-size: 24rpx;
  line-height: 68rpx;
  text-align: center;
}

.tab-item.on {
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(94, 42, 37, 0.08);
  color: #C4161C;
  font-weight: 600;
}

.group {
  margin-bottom: 18rpx;
}

.group-title {
  padding: 0 30rpx 10rpx;
  color: #9A7A6A;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.group-title::before {
  content: "";
  display: inline-block;
  width: 24rpx;
  height: 2rpx;
  margin-right: 10rpx;
  background: #D9A15E;
  vertical-align: 6rpx;
}

.service-card {
  margin: 0 24rpx 12rpx;
  padding: 22rpx 24rpx 18rpx;
}

.service-row {
  display: flex;
  align-items: center;
}

.service-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.service-main {
  flex: 1;
  min-width: 0;
}

.service-name {
  color: #292B2F;
  font-size: 27rpx;
  font-weight: 600;
}

.service-desc {
  margin-top: 2rpx;
  color: #8C8F94;
  font-size: 20rpx;
}

.service-hours {
  margin-top: 2rpx;
  color: #B0A9A4;
  font-size: 18rpx;
}

.call-btn {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  margin-left: 12rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.28);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 21rpx;
}

.call-btn.small {
  height: 56rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.call-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.service-phone {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F4EFEC;
  color: #C4161C;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 招聘 */
.job-card {
  margin: 0 24rpx 14rpx;
  padding: 24rpx 26rpx 20rpx;
}

.job-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.job-main {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.job-title {
  color: #292B2F;
  font-size: 29rpx;
  font-weight: 700;
}

.job-company {
  margin-top: 4rpx;
  color: #8C8F94;
  font-size: 21rpx;
}

.job-salary {
  flex: none;
  color: #C4161C;
  font-size: 24rpx;
  font-weight: 700;
}

.job-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.job-tag {
  height: 34rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  background: #FFF3EC;
  color: #B46332;
  font-size: 18rpx;
  line-height: 34rpx;
}

.job-desc {
  margin-top: 10rpx;
  color: #6E7278;
  font-size: 22rpx;
  line-height: 1.7;
}

.job-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  color: #A19A95;
  font-size: 19rpx;
}

.job-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F4EFEC;
}

.job-contact {
  flex: 1;
  min-width: 0;
  color: #8C8F94;
  font-size: 19rpx;
}

/* 奶茶会 */
.tea-card {
  margin: 0 24rpx 14rpx;
  padding: 24rpx 26rpx 20rpx;
}

.tea-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tea-status {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 36rpx;
}

.tea-status.open {
  background: #EAF4EE;
  color: #2F8A59;
}

.tea-status.end {
  background: #F1EEEC;
  color: #8E8A86;
}

.tea-date {
  color: #C4161C;
  font-size: 21rpx;
  font-weight: 600;
}

.tea-title {
  margin-top: 12rpx;
  color: #292B2F;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tea-location {
  margin-top: 6rpx;
  color: #8C8F94;
  font-size: 21rpx;
}

.tea-progress {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #F1E9E5;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E8641B, #C4161C);
}

.progress-text {
  flex: none;
  margin-left: 12rpx;
  color: #A19A95;
  font-size: 18rpx;
}

.tea-summary {
  margin-top: 14rpx;
  color: #6E7278;
  font-size: 22rpx;
  line-height: 1.75;
}

.tea-agenda {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FAF7F5;
}

.agenda-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  color: #6E625B;
  font-size: 21rpx;
  line-height: 1.6;
}

.agenda-item:last-child {
  margin-bottom: 0;
}

.agenda-index {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  margin: 2rpx 10rpx 0 0;
  border-radius: 50%;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 16rpx;
  line-height: 30rpx;
  text-align: center;
}

.tea-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F4EFEC;
}

.tea-host {
  flex: 1;
  min-width: 0;
  color: #A19A95;
  font-size: 18rpx;
}

.signup-btn {
  flex: none;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 6rpx 14rpx rgba(196, 22, 28, 0.18);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 62rpx;
}

.signup-btn.signed {
  background: #EAF4EE;
  box-shadow: none;
  color: #2F8A59;
}

.signup-btn.disabled {
  background: #F1EEEC;
  box-shadow: none;
  color: #A19A95;
}

.service-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 30rpx 10rpx;
  color: #B0A9A4;
  font-size: 18rpx;
  line-height: 1.9;
}

.meta-dot {
  margin: 0 8rpx;
  color: #D5CFCA;
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}
