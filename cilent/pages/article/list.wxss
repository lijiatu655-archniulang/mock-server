.list-page {
  background: #F6F2F0;
}

.list-head {
  padding: 34rpx 30rpx 26rpx;
  background: linear-gradient(180deg, #FFF9F5 0%, #F6F2F0 100%);
}

.head-kicker {
  display: flex;
  align-items: center;
  color: #A66A4C;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.kicker-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #C4161C;
}

.head-title {
  margin-top: 12rpx;
  color: #222428;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.head-desc {
  margin-top: 6rpx;
  color: #8F8985;
  font-size: 24rpx;
}

.head-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #AAA39E;
  font-size: 22rpx;
}

.head-meta-sep {
  margin: 0 8rpx;
  color: #D5CFCB;
}

.filter-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 14rpx 0 18rpx;
  background: #F6F2F0;
}

.filter-scroll {
  width: 100%;
  height: 78rpx;
  white-space: nowrap;
}

.filter-inner {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.filter-chip {
  display: flex;
  flex: none;
  align-items: center;
  height: 72rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid #EDE5E1;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #666A70;
  font-size: 24rpx;
  white-space: nowrap;
}

.filter-chip:last-child {
  margin-right: 0;
}

.filter-chip.on {
  border-color: transparent;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 18rpx rgba(196, 22, 28, 0.2);
  color: #FFFFFF;
  font-weight: 600;
}

.chip-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.list-body {
  padding: 0 24rpx;
}

.article-card {
  position: relative;
  margin-bottom: 16rpx;
  padding: 26rpx 28rpx 24rpx;
}

.article-card.featured {
  border: 1rpx solid #F4DDD7;
  background: linear-gradient(135deg, #FFF9F5 0%, #FFFFFF 62%);
}

.article-head {
  display: flex;
  align-items: center;
}

.column-label {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 600;
}

.column-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.top-flag {
  height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 18rpx;
  line-height: 30rpx;
}

.article-date {
  margin-left: auto;
  color: #B0A9A4;
  font-size: 21rpx;
}

.article-title {
  margin-top: 14rpx;
  color: #232529;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.article-summary {
  margin-top: 10rpx;
  color: #85888E;
  font-size: 24rpx;
  line-height: 1.7;
}

.article-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F4EFEC;
}

.foot-left {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #A8A19C;
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.foot-dot {
  margin: 0 8rpx;
  color: #D8D2CE;
}

.foot-arrow {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid #C9C3BE;
  border-bottom: 2rpx solid #C9C3BE;
  transform: rotate(-45deg);
}

.list-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 20rpx;
  color: #B0A9A4;
  font-size: 22rpx;
}

.more-line {
  width: 50rpx;
  height: 1rpx;
  margin: 0 16rpx;
  background: #E3DCD8;
}

.loading-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #C4161C;
  animation: blink 0.9s ease infinite;
}

@keyframes blink {
  0%,
  100% {
    opacity: 0.25;
  }
  50% {
    opacity: 1;
  }
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

.card {
  margin-bottom: 16rpx;
}
