<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="page applies-page">
  <view class="list-head">
    <view class="head-left">
      <view class="head-title">{{i18n.t('我的办件', lang)}}</view>
      <view class="head-sub">{{i18n.t('申报记录、进度、评价都在这里', lang)}}</view>
    </view>
    <view class="head-create" bindtap="onCreate" hover-class="press">
      <text>{{i18n.t('去办事', lang)}}</text>
      <view class="arrow arrow-red"></view>
    </view>
  </view>

  <view class="filter-bar">
    <view class="filter-chip {{filter === 'all' ? 'on' : ''}}" data-filter="all" bindtap="onFilterTap">
      全部 <text class="chip-count">{{counts.all}}</text>
    </view>
    <view class="filter-chip {{filter === 'processing' ? 'on' : ''}}" data-filter="processing" bindtap="onFilterTap">
      办理中 <text class="chip-count">{{counts.processing}}</text>
    </view>
    <view class="filter-chip {{filter === 'done' ? 'on' : ''}}" data-filter="done" bindtap="onFilterTap">
      已办结 <text class="chip-count">{{counts.done}}</text>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="apply-card card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-block" style="width:50%;height:32rpx;"></view>
      <view class="sk-block" style="width:90%;height:26rpx;margin-top:18rpx;"></view>
      <view class="sk-block" style="width:60%;height:22rpx;margin-top:16rpx;"></view>
    </view>
  </block>

  <view class="state-box card" wx:elif="{{error}}">
    <view class="state-emoji">!</view>
    <view class="state-title">{{i18n.t('办件没有加载出来', lang)}}</view>
    <view class="state-desc">{{error}}</view>
    <view class="state-action" bindtap="retry">{{i18n.t('重新加载', lang)}}</view>
  </view>

  <view class="state-box card" wx:elif="{{!applies.length}}">
    <view class="state-emoji">{{i18n.t('办', lang)}}</view>
    <view class="state-title">{{counts.all ? i18n.t('这个分类暂无办件', lang) : i18n.t('还没有办件', lang)}}</view>
    <view class="state-desc">{{counts.all ? i18n.t('切换上方筛选，看看其他办件。', lang) : i18n.t('医保缴费、高龄补贴、独生子女证等事项，都可以在线申报。', lang)}}</view>
    <view class="state-action" wx:if="{{!counts.all}}" bindtap="onCreate">{{i18n.t('去办事', lang)}}</view>
    <view class="state-action" wx:else data-filter="all" bindtap="onFilterTap">{{i18n.t('查看全部', lang)}}</view>
  </view>

  <block wx:else>
    <view
      class="apply-card card"
      wx:for="{{applies}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItemTap"
      hover-class="press"
    >
      <view class="card-top">
        <view class="apply-name line-1">{{item.itemName}}</view>
        <view class="status-tag {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="apply-no">办件号：{{item.applyNo}}</view>
      <view class="apply-meta">
        <text class="apply-amount" wx:if="{{item.amount > 0}}">{{item.amountText}}</text>
        <text class="apply-amount free" wx:else>{{i18n.t('免费', lang)}}</text>
        <text class="meta-dot">·</text>
        <text>提交于 {{item.createdDate}}</text>
        <text class="meta-dot">·</text>
        <text>承诺 {{item.promiseAt}}</text>
      </view>
      <view class="card-foot">
        <text>{{item.status === 'SUPPLEMENT' ? i18n.t('需要补材料，点开查看', lang) : item.status === 'COMPLETED' ? i18n.t('已办结，可查看结果', lang) : i18n.t('查看办理进度', lang)}}</text>
        <view class="arrow"></view>
      </view>
    </view>
  </block>
</view>
