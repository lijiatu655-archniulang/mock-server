<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="page apply-page" wx:if="{{item}}">
  <view class="apply-head">
    <view class="head-row">
      <view class="head-icon" style="background:{{item.iconTint}};">{{item.icon}}</view>
      <view class="head-main">
        <view class="head-cat">{{item.categoryName}} · 在线申报</view>
        <view class="head-name">{{item.name}}</view>
      </view>
    </view>
    <view class="head-meta">
      <view class="meta-item">
        <text class="meta-num">{{item.promiseDays}}</text>
        <text class="meta-label">{{i18n.t('个工作日', lang)}}</text>
      </view>
      <view class="meta-line"></view>
      <view class="meta-item">
        <text class="meta-num">1</text>
        <text class="meta-label">{{i18n.t('次跑动', lang)}}</text>
      </view>
      <view class="meta-line"></view>
      <view class="meta-item meta-fee">
        <text class="meta-value">{{item.fee}}</text>
        <text class="meta-label">{{i18n.t('收费标准', lang)}}</text>
      </view>
    </view>
  </view>

  <view class="tip-bar">
    <view class="tip-dot"></view>
    <text>{{i18n.t('带 * 为必填项；材料可先提交，缺项会进入“待补正”。', lang)}}</text>
  </view>

  <view class="form-card card">
    <view class="card-title">
      <view class="title-bar"></view>
      <text>{{i18n.t('填写申报信息', lang)}}</text>
    </view>
    <view class="form-error" wx:if="{{formError}}">{{formError}}</view>

    <view class="form-field" wx:for="{{fields}}" wx:key="label" wx:for-item="field" wx:for-index="fi">
      <view class="field-label">
        <text>{{field.label}}</text>
        <text class="field-required" wx:if="{{field.required}}">*</text>
        <text class="field-type">{{field.type === 'idcard' ? i18n.t('身份证号', lang) : field.type === 'select' ? i18n.t('单选', lang) : field.type === 'radio' ? i18n.t('单选', lang) : field.type === 'date' ? i18n.t('日期', lang) : i18n.t('文本', lang)}}</text>
      </view>

      <block wx:if="{{field.type === 'select'}}">
        <picker mode="selector" range="{{field.options}}" data-index="{{fi}}" bindchange="onSelectChange">
          <view class="field-control {{field.value ? '' : 'placeholder'}}">
            <text>{{field.value || field.placeholder}}</text>
            <view class="field-arrow"></view>
          </view>
        </picker>
      </block>

      <block wx:elif="{{field.type === 'radio'}}">
        <view class="radio-row">
          <view
            class="radio-chip {{field.value === opt ? 'on' : ''}}"
            wx:for="{{field.options}}"
            wx:key="*this"
            wx:for-item="opt"
            data-index="{{fi}}"
            data-option="{{opt}}"
            bindtap="onRadioTap"
            hover-class="press"
          >{{opt}}</view>
        </view>
      </block>

      <block wx:elif="{{field.type === 'date'}}">
        <picker mode="date" value="{{field.value}}" data-index="{{fi}}" bindchange="onDateChange">
          <view class="field-control {{field.value ? '' : 'placeholder'}}">
            <text>{{field.value || field.placeholder}}</text>
            <view class="field-arrow"></view>
          </view>
        </picker>
      </block>

      <block wx:else>
        <input
          class="field-input"
          type="{{field.type === 'idcard' ? 'idcard' : 'text'}}"
          value="{{field.value}}"
          placeholder="{{field.placeholder}}"
          placeholder-class="field-placeholder"
          data-index="{{fi}}"
          bindinput="onFieldInput"
          maxlength="{{field.type === 'idcard' ? 18 : 50}}"
        />
      </block>
    </view>
  </view>

  <view class="form-card card">
    <view class="card-title">
      <view class="title-bar"></view>
      <text>{{i18n.t('上传申请材料', lang)}}</text>
      <text class="card-sub">{{i18n.t('选填，可现场补交', lang)}}</text>
    </view>
    <view class="material-row" wx:for="{{materials}}" wx:key="name" wx:for-item="material" wx:for-index="mi">
      <view class="material-icon">
        <image class="material-img" src="/assets/icons/icon-doc.png" mode="aspectFit"></image>
      </view>
      <view class="material-main">
        <view class="material-name">
          <text>{{material.name}}</text>
          <text class="material-tag required" wx:if="{{material.required}}">{{i18n.t('必需', lang)}}</text>
          <text class="material-tag optional" wx:else>{{i18n.t('可选', lang)}}</text>
        </view>
        <view class="material-note">{{material.note}}</view>
      </view>
      <view
        class="material-btn {{material.uploaded ? 'done' : ''}}"
        data-index="{{mi}}"
        bindtap="onMaterialTap"
        hover-class="press"
      >{{material.uploaded ? i18n.t('已选择', lang) : i18n.t('选择照片', lang)}}</view>
    </view>
    <view class="material-tip">{{i18n.t('材料可到村党群服务中心免费复印；行动不便的老人可联系网格员上门收取。', lang)}}</view>
  </view>

  <view class="agree-row" bindtap="onAgreeTap" hover-class="press">
    <view class="agree-box {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
    <text>{{i18n.t('我承诺填写信息真实有效，并已阅读《办事须知》', lang)}}</text>
  </view>

  <view class="apply-footer">
    <view class="footer-note">{{i18n.t('提交后可在「我的办件」查看进度', lang)}}</view>
    <view class="submit-btn {{submitting ? 'loading' : ''}}" bindtap="onSubmit" hover-class="press">
      {{submitting ? i18n.t('正在提交…', lang) : i18n.t('提交申请', lang)}}
    </view>
  </view>
</view>

<view class="page" wx:elif="{{loading}}">
  <view class="apply-head">
    <view class="sk-block light" style="width:60%;height:36rpx;"></view>
    <view class="sk-block light" style="width:80%;height:30rpx;margin-top:16rpx;"></view>
  </view>
  <view class="form-card card">
    <view class="sk-block" style="width:40%;height:30rpx;"></view>
    <view class="sk-block" style="width:100%;height:80rpx;margin-top:24rpx;"></view>
    <view class="sk-block" style="width:100%;height:80rpx;margin-top:18rpx;"></view>
    <view class="sk-block" style="width:100%;height:80rpx;margin-top:18rpx;"></view>
  </view>
</view>

<view class="page" wx:else>
  <view class="state-box card" style="margin:40rpx 24rpx;">
    <view class="state-emoji">!</view>
    <view class="state-title">{{i18n.t('申报页没有加载出来', lang)}}</view>
    <view class="state-desc">{{error}}</view>
    <view class="state-action" bindtap="retry">{{i18n.t('重新加载', lang)}}</view>
  </view>
</view>
