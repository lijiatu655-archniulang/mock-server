.apply-detail-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #F6F2F0;
}

.detail-head {
  padding: 30rpx 30rpx 26rpx;
  background: linear-gradient(180deg, #FFF8F3 0%, #F6F2F0 100%);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-pill {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.theme-orange {
  background: #FDF1E8;
  color: #C2571A;
}

.theme-blue {
  background: #EAF4FB;
  color: #2F7FB8;
}

.theme-red {
  background: #FBEBEB;
  color: #C4161C;
}

.theme-green {
  background: #EAF4EE;
  color: #2F8A59;
}

.theme-gray {
  background: #F1EEEC;
  color: #8E8A86;
}

.status-time {
  color: #A19A95;
  font-size: 20rpx;
}

.detail-title {
  margin-top: 18rpx;
  color: #222428;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.detail-no {
  margin-top: 10rpx;
  color: #A19A95;
  font-size: 21rpx;
}

.alert-card {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
}

.alert-card.warn {
  border: 1rpx solid #F4D8CE;
  background: #FFF8F5;
}

.alert-card.done {
  border: 1rpx solid #DCEFE4;
  background: #F5FBF7;
}

.alert-icon {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.alert-card.done .alert-icon {
  background: #EAF4EE;
  color: #2F8A59;
}

.alert-main {
  flex: 1;
  min-width: 0;
}

.alert-title {
  color: #5A3B2E;
  font-size: 24rpx;
  font-weight: 600;
}

.alert-card.done .alert-title {
  color: #2C5F42;
}

.alert-desc {
  margin-top: 4rpx;
  color: #9A7A6A;
  font-size: 20rpx;
  line-height: 1.7;
}

.alert-card.done .alert-desc {
  color: #6C8A79;
}

.alert-action {
  display: inline-block;
  height: 44rpx;
  margin-top: 10rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.28);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 19rpx;
  line-height: 42rpx;
}

.section {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  color: #26282B;
  font-size: 29rpx;
  font-weight: 700;
}

.section-title::before {
  content: "";
  width: 7rpx;
  height: 25rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #E23B32, #A8111A);
}

.section-sub {
  color: #A8A19C;
  font-size: 19rpx;
}

/* ---------- 时间轴 ---------- */
.timeline {
  padding-top: 4rpx;
}

.timeline-item {
  display: flex;
}

.timeline-left {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  margin-right: 14rpx;
}

.timeline-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border: 3rpx solid #E8DDD8;
  border-radius: 50%;
  background: #FFFFFF;
}

.timeline-dot.active {
  border-color: #C4161C;
  background: #C4161C;
  box-shadow: 0 0 0 6rpx rgba(196, 22, 28, 0.1);
}

.timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 44rpx;
  background: #F0E7E3;
}

.timeline-main {
  flex: 1;
  min-width: 0;
  padding-bottom: 26rpx;
}

.timeline-title {
  color: #6E7278;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.6;
}

.timeline-title.active {
  color: #C4161C;
  font-weight: 600;
}

.timeline-note {
  margin-top: 2rpx;
  color: #8E918F;
  font-size: 21rpx;
  line-height: 1.7;
}

.timeline-meta {
  margin-top: 4rpx;
  color: #B4ADA8;
  font-size: 19rpx;
}

/* ---------- 信息 ---------- */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #F5EFEC;
}

.info-row.info-last {
  border-bottom: 0;
  padding-bottom: 0;
}

.info-label {
  flex: none;
  width: 128rpx;
  color: #9A938E;
  font-size: 22rpx;
  line-height: 1.7;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #3E4146;
  font-size: 23rpx;
  line-height: 1.7;
  word-break: break-all;
}

.info-value.amount {
  color: #C4161C;
  font-weight: 600;
}

.phone-value {
  display: flex;
  align-items: center;
  color: #C4161C;
}

.phone-action {
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #FBEBEB;
  font-size: 18rpx;
  line-height: 34rpx;
}

/* ---------- 材料 ---------- */
.material-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #F0E9E5;
}

.material-row:last-child {
  border-bottom: 0;
}

.material-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #FBF1EE;
}

.material-img {
  width: 30rpx;
  height: 30rpx;
}

.material-main {
  flex: 1;
  min-width: 0;
}

.material-name {
  color: #34363A;
  font-size: 23rpx;
  font-weight: 500;
}

.material-note {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 19rpx;
}

.material-status {
  flex: none;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 36rpx;
}

.material-status.ok {
  background: #EAF4EE;
  color: #2F8A59;
}

.material-status.pending {
  background: #FBEBEB;
  color: #C4161C;
}

/* ---------- 已评价 ---------- */
.rated-card {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #F3E7DF;
  border-radius: 16rpx;
  background: #FFFBF7;
  text-align: center;
}

.rated-stars {
  display: flex;
  justify-content: center;
}

.star {
  margin: 0 4rpx;
  color: #E3D7CF;
  font-size: 40rpx;
  line-height: 1.2;
}

.star.on {
  color: #E8A13C;
}

.rated-text {
  margin-top: 4rpx;
  color: #9A7A6A;
  font-size: 20rpx;
}

.detail-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 30rpx 16rpx;
  color: #B0A9A4;
  font-size: 19rpx;
  line-height: 1.9;
}

/* ---------- 底部操作 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #F0E9E5;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(94, 42, 37, 0.05);
}

.bar-ghost {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 88rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.3);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 26rpx;
  font-weight: 500;
}

.bar-primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 20rpx rgba(196, 22, 28, 0.22);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.bar-primary.muted {
  background: #F3EFED;
  box-shadow: none;
  color: #8E8A86;
}

/* ---------- 评价弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 12, 10, 0.46);
}

.rating-sheet {
  width: 100%;
  padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  animation: sheetUp 0.26s ease both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #E8E0DC;
}

.sheet-title {
  color: #26282B;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-sub {
  margin-top: 6rpx;
  color: #A19A95;
  font-size: 20rpx;
  text-align: center;
}

.star-row {
  display: flex;
  justify-content: center;
  margin-top: 22rpx;
}

.star-row .star {
  margin: 0 10rpx;
  font-size: 62rpx;
}

.star-tip {
  margin-top: 4rpx;
  color: #C99437;
  font-size: 22rpx;
  text-align: center;
}

.rating-input {
  width: 100%;
  height: 160rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx solid #EDE4DF;
  border-radius: 14rpx;
  background: #FBF8F6;
  color: #33363A;
  font-size: 25rpx;
  line-height: 1.6;
}

.rating-placeholder {
  color: #B5AEAA;
  font-size: 23rpx;
}

.sheet-submit {
  height: 88rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.sheet-submit.loading {
  opacity: 0.65;
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}
