.gov-detail {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: #F6F2F0;
}

/* ---------- 头部 ---------- */
.item-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 52rpx;
  background: linear-gradient(145deg, #8E0B11 0%, #B8141B 46%, #CE1F26 76%, #DB3B2F 100%);
}

.hero-glow {
  position: absolute;
  top: -160rpx;
  right: -130rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 150, 0.26) 0%, rgba(255, 214, 150, 0) 68%);
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
}

.hero-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.hero-cat {
  color: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.hero-name {
  margin-top: 8rpx;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.hero-tags {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-tag {
  height: 38rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.88);
  font-size: 19rpx;
  line-height: 36rpx;
}

.hero-update {
  position: relative;
  z-index: 2;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 19rpx;
  line-height: 1.6;
}

/* ---------- 关键指标 ---------- */
.key-card {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: stretch;
  margin: -34rpx 24rpx 18rpx;
  padding: 24rpx 0;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 30rpx rgba(94, 42, 37, 0.1);
}

.key-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 0 8rpx;
}

.key-value {
  color: #C4161C;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
}

.key-value-small {
  font-size: 28rpx;
}

.key-unit {
  margin-left: 4rpx;
  color: #8C8F94;
  font-size: 19rpx;
  font-weight: 400;
}

.key-label {
  margin-top: 4rpx;
  color: #A19A95;
  font-size: 20rpx;
}

.key-divider {
  width: 1rpx;
  margin: 8rpx 0;
  background: #F1EBE7;
}

/* ---------- 通用版块 ---------- */
.section {
  margin: 0 24rpx 18rpx;
  padding: 26rpx 26rpx 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  color: #26282B;
  font-size: 30rpx;
  font-weight: 700;
}

.section-title::before {
  content: "";
  width: 7rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #E23B32, #A8111A);
}

.section-count {
  color: #A8A19C;
  font-size: 20rpx;
}

/* ---------- 基本信息 ---------- */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #F5EFEC;
}

.info-row-last {
  border-bottom: 0;
  padding-bottom: 4rpx;
}

.info-label {
  flex: none;
  width: 116rpx;
  color: #9A938E;
  font-size: 23rpx;
  line-height: 1.7;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #3E4146;
  font-size: 24rpx;
  line-height: 1.7;
}

.phone-value {
  display: flex;
  align-items: center;
  color: #C4161C;
}

.phone-action {
  height: 36rpx;
  margin-left: 12rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 19rpx;
  line-height: 36rpx;
}

/* ---------- 条件 ---------- */
.condition {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.condition:last-child {
  margin-bottom: 0;
}

.condition-index {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin: 4rpx 14rpx 0 0;
  border-radius: 50%;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.condition-text {
  flex: 1;
  color: #4B4E53;
  font-size: 25rpx;
  line-height: 1.75;
}

/* ---------- 材料 ---------- */
.material {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #F0E9E5;
}

.material:last-of-type {
  border-bottom: 0;
}

.material-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  border-radius: 14rpx;
  background: #FBF1EE;
}

.material-img {
  width: 32rpx;
  height: 32rpx;
}

.material-main {
  flex: 1;
  min-width: 0;
}

.material-name {
  display: flex;
  align-items: center;
  color: #34363A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.material-tag {
  flex: none;
  height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  font-size: 17rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.material-tag.required {
  background: #FBEBEB;
  color: #C4161C;
}

.material-tag.optional {
  background: #F3EFED;
  color: #9A938E;
}

.material-note {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 21rpx;
  line-height: 1.6;
}

.material-tip {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #FAF7F5;
  color: #918A85;
  font-size: 20rpx;
  line-height: 1.7;
}

/* ---------- 流程 ---------- */
.step {
  display: flex;
}

.step-left {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
  margin-right: 14rpx;
}

.step-dot {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #E8DDD8;
  border-radius: 50%;
  background: #FFFFFF;
  color: #B3ACA7;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: center;
}

.step-dot-first {
  border-color: transparent;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  color: #FFFFFF;
}

.step-line {
  flex: 1;
  width: 2rpx;
  min-height: 34rpx;
  background: #F0E7E3;
}

.step-main {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
}

.step-title {
  padding-top: 2rpx;
  color: #33363A;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.step-desc {
  margin-top: 4rpx;
  color: #8E918F;
  font-size: 22rpx;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.v2-tag {
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 18rpx;
  line-height: 34rpx;
}

.form-note {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #FFF8F3;
  color: #9A5A31;
  font-size: 20rpx;
  line-height: 1.7;
}

.form-note-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin: 10rpx 10rpx 0 0;
  border-radius: 50%;
  background: #E0A45E;
}

.form-row {
  margin-bottom: 18rpx;
}

.form-row:last-child {
  margin-bottom: 0;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  color: #4B4E53;
  font-size: 23rpx;
}

.form-required {
  margin-left: 4rpx;
  color: #C4161C;
}

.form-type {
  margin-left: auto;
  color: #B5AEAA;
  font-size: 18rpx;
}

.form-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx dashed #E6DCD7;
  border-radius: 12rpx;
  background: #FAF7F5;
}

.form-placeholder {
  color: #B5AEAA;
  font-size: 23rpx;
}

.form-lock {
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: #F0E9E5;
  color: #A79F99;
  font-size: 16rpx;
  line-height: 30rpx;
}

.form-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.form-option {
  height: 40rpx;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 0 12rpx;
  border: 1rpx solid #F0E5DF;
  border-radius: 6rpx;
  background: #FFFFFF;
  color: #8C8F94;
  font-size: 19rpx;
  line-height: 38rpx;
}

/* ---------- 依据 / FAQ ---------- */
.basis {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  color: #5E6166;
  font-size: 23rpx;
  line-height: 1.7;
}

.basis:last-child {
  margin-bottom: 0;
}

.basis-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin: 11rpx 12rpx 0 0;
  border-radius: 50%;
  background: #C4161C;
}

.faq {
  border-bottom: 1rpx solid #F5EFEC;
}

.faq:last-child {
  border-bottom: 0;
}

.faq-q {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  color: #42454A;
  font-size: 24rpx;
  line-height: 1.6;
}

.faq-q text {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.faq-arrow {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid #B3ACA7;
  border-bottom: 2rpx solid #B3ACA7;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.faq-arrow.open {
  transform: rotate(225deg);
}

.faq-a {
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAF7F5;
  color: #7E817F;
  font-size: 22rpx;
  line-height: 1.85;
}

.readonly-note {
  display: flex;
  align-items: flex-start;
  margin: 4rpx 24rpx 30rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #EFE6E2;
  border-radius: 14rpx;
  background: #FFFDFC;
  color: #9A938E;
  font-size: 20rpx;
  line-height: 1.7;
}

.readonly-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin: 2rpx 10rpx 0 0;
  border-radius: 50%;
  background: #F1E7E2;
  color: #9A7A6A;
  font-size: 17rpx;
  font-style: italic;
  line-height: 28rpx;
  text-align: center;
}

/* ---------- 底部操作 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 24rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #F0E9E5;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(94, 42, 37, 0.05);
}

.bar-ghost {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 88rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.3);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 26rpx;
  font-weight: 500;
}

.bar-primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 20rpx rgba(196, 22, 28, 0.22);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.bar-v2 {
  margin-left: 10rpx;
  padding: 0 10rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFE9C8;
  font-size: 16rpx;
  font-weight: 400;
  line-height: 30rpx;
}

/* ---------- 骨架 ---------- */
.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

.sk-block.light {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 25%, rgba(255, 255, 255, 0.3) 37%, rgba(255, 255, 255, 0.16) 63%);
  background-size: 400% 100%;
}

.sk-hero-icon {
  width: 94rpx;
  height: 94rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
}
