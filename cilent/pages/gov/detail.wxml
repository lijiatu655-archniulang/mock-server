<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="page gov-detail" wx:if="{{item}}">
  <view class="item-hero">
    <view class="hero-glow"></view>
    <view class="hero-top">
      <view class="hero-icon">{{item.icon}}</view>
      <view class="hero-main">
        <view class="hero-cat">{{item.categoryName}} · {{item.code}}</view>
        <view class="hero-name">{{item.name}}</view>
      </view>
    </view>
    <view class="hero-tags">
      <text class="hero-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
    </view>
    <view class="hero-update">指南更新：{{item.updateAt}} · 信息由永吉县政务服务平台提供</view>
  </view>

  <view class="key-card card">
    <view class="key-item">
      <view class="key-value">{{item.promiseDays}}<text class="key-unit">{{i18n.t('个工作日', lang)}}</text></view>
      <view class="key-label">{{i18n.t('承诺时限', lang)}}</view>
    </view>
    <view class="key-divider"></view>
    <view class="key-item">
      <view class="key-value">{{item.materials.length}}<text class="key-unit">{{i18n.t('项', lang)}}</text></view>
      <view class="key-label">{{i18n.t('所需材料', lang)}}</view>
    </view>
    <view class="key-divider"></view>
    <view class="key-item">
      <view class="key-value key-value-small">{{item.feeShort}}</view>
      <view class="key-label">{{i18n.t('收费标准', lang)}}</view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('基本信息', lang)}}</view>
    </view>
    <view class="info-row">
      <text class="info-label">{{i18n.t('办理对象', lang)}}</text>
      <text class="info-value">{{item.target}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{i18n.t('收费标准', lang)}}</text>
      <text class="info-value">{{item.fee}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{i18n.t('办理地址', lang)}}</text>
      <text class="info-value">{{item.address}}</text>
    </view>
    <view class="info-row info-row-last">
      <text class="info-label">{{i18n.t('咨询电话', lang)}}</text>
      <view class="info-value phone-value" bindtap="onCall">
        <text>{{item.phone}}</text>
        <text class="phone-action">{{i18n.t('拨打', lang)}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('办理条件', lang)}}</view>
      <view class="section-count">{{i18n.t('请逐条核对', lang)}}</view>
    </view>
    <view class="condition" wx:for="{{item.conditions}}" wx:key="*this" wx:for-item="condition">
      <view class="condition-index">{{index + 1}}</view>
      <text class="condition-text">{{condition}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('所需材料', lang)}}</view>
      <view class="section-count">共 {{item.materials.length}} 项，其中必需 {{item.requiredCount}} 项</view>
    </view>
    <view class="material" wx:for="{{item.materials}}" wx:key="name" wx:for-item="material">
      <view class="material-icon">
        <image class="material-img" src="/assets/icons/icon-doc.png" mode="aspectFit"></image>
      </view>
      <view class="material-main">
        <view class="material-name">
          <text>{{material.name}}</text>
          <text class="material-tag required" wx:if="{{material.required}}">{{i18n.t('必需', lang)}}</text>
          <text class="material-tag optional" wx:else>{{i18n.t('可选', lang)}}</text>
        </view>
        <view class="material-note">{{material.note}}</view>
      </view>
    </view>
    <view class="material-tip">{{i18n.t('材料可到村党群服务中心免费复印；行动不便的老人可联系网格员上门收取。', lang)}}</view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('办理流程', lang)}}</view>
      <view class="section-count">共 {{item.steps.length}} 步</view>
    </view>
    <view class="step" wx:for="{{item.steps}}" wx:key="title" wx:for-item="step" wx:for-index="stepIndex">
      <view class="step-left">
        <view class="step-dot {{stepIndex === 0 ? 'step-dot-first' : ''}}">{{stepIndex + 1}}</view>
        <view class="step-line" wx:if="{{stepIndex < item.steps.length - 1}}"></view>
      </view>
      <view class="step-main">
        <view class="step-title">{{step.title}}</view>
        <view class="step-desc">{{step.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('申报表单', lang)}}</view>
      <view class="v2-tag">{{i18n.t('可在线填写', lang)}}</view>
    </view>
    <view class="form-note">
      <view class="form-note-dot"></view>
      <text>{{i18n.t('点击“在线申报”后按以下表单填写，带 * 为必填项。', lang)}}</text>
    </view>
    <view class="form-row" wx:for="{{item.formFields}}" wx:key="label" wx:for-item="field">
      <view class="form-label">
        <text>{{field.label}}</text>
        <text class="form-required" wx:if="{{field.required}}">*</text>
        <text class="form-type">{{field.typeLabel}}</text>
      </view>
      <view class="form-control">
        <text class="form-placeholder">{{field.placeholder}}</text>
        <text class="form-lock">{{i18n.t('预览', lang)}}</text>
      </view>
      <view class="form-options" wx:if="{{field.options}}">
        <text class="form-option" wx:for="{{field.options}}" wx:key="*this" wx:for-item="opt">{{opt}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view class="section-title">{{i18n.t('政策依据', lang)}}</view>
    </view>
    <view class="basis" wx:for="{{item.basis}}" wx:key="*this" wx:for-item="rule">
      <view class="basis-dot"></view>
      <text>{{rule}}</text>
    </view>
  </view>

  <view class="section card" wx:if="{{item.faqs && item.faqs.length}}">
    <view class="section-head">
      <view class="section-title">{{i18n.t('常见问题', lang)}}</view>
    </view>
    <view class="faq" wx:for="{{item.faqs}}" wx:key="q" wx:for-item="faq">
      <view class="faq-q" data-index="{{index}}" bindtap="toggleFaq" hover-class="press">
        <text>{{faq.q}}</text>
        <view class="faq-arrow {{faqOpen === index ? 'open' : ''}}"></view>
      </view>
      <view class="faq-a" wx:if="{{faqOpen === index}}">{{faq.a}}</view>
    </view>
  </view>

  <view class="readonly-note">
    <view class="readonly-icon">i</view>
    <text>{{i18n.t('在线申报已开放；提交后可在「我的办件」查看进度、补正提醒和评价。', lang)}}</text>
  </view>

  <view class="bottom-bar">
    <view class="bar-ghost" bindtap="onCall" hover-class="press">{{i18n.t('电话咨询', lang)}}</view>
    <view class="bar-primary" bindtap="onApply" hover-class="press">{{i18n.t('在线申报', lang)}}</view>
  </view>
</view>

<view class="page" wx:elif="{{loading}}">
  <view class="item-hero">
    <view class="sk-hero-icon"></view>
    <view class="sk-block light" style="width:70%;height:44rpx;margin-top:24rpx;"></view>
    <view class="sk-block light" style="width:48%;height:24rpx;margin-top:18rpx;"></view>
  </view>
  <view class="key-card card">
    <view class="sk-block" style="width:80%;height:44rpx;margin:10rpx auto;"></view>
    <view class="sk-block" style="width:60%;height:44rpx;margin:10rpx auto;"></view>
    <view class="sk-block" style="width:70%;height:44rpx;margin:10rpx auto;"></view>
  </view>
  <view class="section card" style="height:260rpx;">
    <view class="sk-block" style="width:40%;height:30rpx;"></view>
    <view class="sk-block" style="width:96%;height:24rpx;margin-top:22rpx;"></view>
    <view class="sk-block" style="width:88%;height:24rpx;margin-top:14rpx;"></view>
    <view class="sk-block" style="width:72%;height:24rpx;margin-top:14rpx;"></view>
  </view>
</view>

<view class="page" wx:else>
  <view class="state-box card" style="margin:40rpx 24rpx;">
    <view class="state-emoji">!</view>
    <view class="state-title">{{i18n.t('事项没有加载出来', lang)}}</view>
    <view class="state-desc">{{error}}</view>
    <view class="state-action" bindtap="retry">{{i18n.t('重新加载', lang)}}</view>
  </view>
</view>
