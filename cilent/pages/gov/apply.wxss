.apply-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  background: #F6F2F0;
}

.apply-head {
  padding: 30rpx 24rpx 24rpx;
  background: linear-gradient(180deg, #FFF7F2 0%, #F6F2F0 100%);
}

.head-row {
  display: flex;
  align-items: flex-start;
}

.head-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  color: #C4161C;
  font-size: 34rpx;
  font-weight: 700;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-cat {
  color: #A06A4C;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.head-name {
  margin-top: 6rpx;
  color: #24262A;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.head-meta {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid #F3E6DE;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.meta-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.meta-num {
  color: #C4161C;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.meta-label {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 18rpx;
}

.meta-value {
  max-width: 100%;
  overflow: hidden;
  color: #C4161C;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta-line {
  width: 1rpx;
  height: 48rpx;
  background: #F0E5DE;
}

.tip-bar {
  display: flex;
  align-items: flex-start;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #F6E3D6;
  border-radius: 14rpx;
  background: #FFF8F3;
  color: #9A5A31;
  font-size: 21rpx;
  line-height: 1.6;
}

.tip-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin: 11rpx 10rpx 0 0;
  border-radius: 50%;
  background: #E0A45E;
}

.form-card {
  margin: 0 24rpx 16rpx;
  padding: 26rpx 26rpx 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  color: #26282B;
  font-size: 30rpx;
  font-weight: 700;
}

.title-bar {
  width: 7rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #E23B32, #A8111A);
}

.card-sub {
  margin-left: auto;
  color: #A8A19C;
  font-size: 19rpx;
  font-weight: 400;
}

.form-error {
  margin-bottom: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #FFF1EE;
  color: #C4161C;
  font-size: 21rpx;
  line-height: 1.6;
}

.form-field {
  margin-bottom: 22rpx;
}

.form-field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  color: #4B4E53;
  font-size: 23rpx;
}

.field-required {
  margin-left: 4rpx;
  color: #C4161C;
}

.field-type {
  margin-left: auto;
  color: #B5AEAA;
  font-size: 18rpx;
}

.field-input,
.field-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 84rpx;
  padding: 0 18rpx;
  border: 1rpx solid #EDE4DF;
  border-radius: 12rpx;
  background: #FBF8F6;
  color: #33363A;
  font-size: 26rpx;
}

.field-placeholder {
  color: #B5AEAA;
  font-size: 24rpx;
}

.field-control.placeholder {
  color: #B5AEAA;
  font-size: 24rpx;
}

.field-arrow {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-right: 2rpx solid #B8B1AC;
  border-bottom: 2rpx solid #B8B1AC;
  transform: rotate(45deg) translateY(-3rpx);
}

.radio-row {
  display: flex;
  flex-wrap: wrap;
}

.radio-chip {
  height: 66rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 0 22rpx;
  border: 1rpx solid #EDE4DF;
  border-radius: 999rpx;
  background: #FBF8F6;
  color: #6E7278;
  font-size: 23rpx;
  line-height: 64rpx;
}

.radio-chip.on {
  border-color: transparent;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  color: #FFFFFF;
  font-weight: 500;
}

.material-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #F0E9E5;
}

.material-row:last-of-type {
  border-bottom: 0;
}

.material-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #FBF1EE;
}

.material-img {
  width: 30rpx;
  height: 30rpx;
}

.material-main {
  flex: 1;
  min-width: 0;
}

.material-name {
  display: flex;
  align-items: center;
  color: #34363A;
  font-size: 24rpx;
  font-weight: 500;
}

.material-tag {
  flex: none;
  height: 28rpx;
  margin-left: 8rpx;
  padding: 0 7rpx;
  border-radius: 4rpx;
  font-size: 16rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.material-tag.required {
  background: #FBEBEB;
  color: #C4161C;
}

.material-tag.optional {
  background: #F3EFED;
  color: #9A938E;
}

.material-note {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 19rpx;
  line-height: 1.5;
}

.material-btn {
  flex: none;
  height: 54rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.28);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 20rpx;
  line-height: 52rpx;
}

.material-btn.done {
  border-color: transparent;
  background: #EDF7F1;
  color: #2F8A59;
}

.material-tip {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #FAF7F5;
  color: #918A85;
  font-size: 19rpx;
  line-height: 1.7;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  margin: 4rpx 30rpx 20rpx;
  color: #6E7278;
  font-size: 22rpx;
  line-height: 1.65;
}

.agree-box {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin: 4rpx 12rpx 0 0;
  border: 2rpx solid #D8CEC8;
  border-radius: 6rpx;
  background: #FFFFFF;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.agree-box.on {
  border-color: #C4161C;
  background: #C4161C;
}

.apply-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0E9E5;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(94, 42, 37, 0.05);
}

.footer-note {
  margin-bottom: 10rpx;
  color: #A19A95;
  font-size: 19rpx;
  text-align: center;
}

.submit-btn {
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 20rpx rgba(196, 22, 28, 0.22);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.submit-btn.loading {
  opacity: 0.7;
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

.sk-block.light {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.2) 25%, rgba(255, 255, 255, 0.35) 37%, rgba(255, 255, 255, 0.2) 63%);
  background-size: 400% 100%;
}
