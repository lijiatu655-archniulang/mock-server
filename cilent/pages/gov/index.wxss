.gov-page {
  background: #F6F2F0;
  padding-bottom: 40rpx;
}

.gov-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx 30rpx 56rpx;
  background: linear-gradient(145deg, #8E0B11 0%, #B8141B 46%, #CE1F26 76%, #DB3B2F 100%);
}

.hero-glow {
  position: absolute;
  top: -150rpx;
  right: -120rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 150, 0.28) 0%, rgba(255, 214, 150, 0) 68%);
}

.hero-lines {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image: repeating-linear-gradient(
    125deg,
    rgba(255, 255, 255, 0.035) 0,
    rgba(255, 255, 255, 0.035) 1rpx,
    transparent 1rpx,
    transparent 22rpx
  );
}

.hero-badge {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 14rpx 0 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
}

.badge-shield {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #F2C87E;
  color: #8E0F14;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.hero-title {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 3rpx;
}

.hero-sub {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-stats {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  min-width: 130rpx;
}

.stat-num {
  color: #FFE7B8;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}

.stat-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 19rpx;
}

.stat-line {
  width: 1rpx;
  height: 46rpx;
  margin: 0 28rpx;
  background: rgba(255, 255, 255, 0.16);
}

.search-card {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  height: 92rpx;
  margin: -42rpx 24rpx 22rpx;
  padding: 0 12rpx 0 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(94, 42, 37, 0.1);
}

.search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  color: #33363A;
  font-size: 26rpx;
}

.search-placeholder {
  color: #B4ADA8;
  font-size: 25rpx;
}

.search-clear {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  color: #B4ADA8;
  font-size: 34rpx;
  line-height: 44rpx;
  text-align: center;
}

.search-btn {
  flex: none;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.cate-scroll {
  width: 100%;
  height: 88rpx;
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.cate-inner {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.cate-chip {
  display: flex;
  flex: none;
  align-items: center;
  height: 72rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid #EDE5E1;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5E6268;
  font-size: 24rpx;
  white-space: nowrap;
}

.cate-chip:last-child {
  margin-right: 0;
}

.cate-chip.on {
  border-color: transparent;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 18rpx rgba(196, 22, 28, 0.2);
  color: #FFFFFF;
  font-weight: 600;
}

.cate-count {
  margin-left: 8rpx;
  padding: 0 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #F5F0ED;
  color: #A19A95;
  font-size: 18rpx;
  line-height: 30rpx;
}

.cate-chip.on .cate-count {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.v2-tip {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #F5E3D6;
  border-radius: 14rpx;
  background: #FFF8F3;
  color: #9A5A31;
  font-size: 21rpx;
  line-height: 1.55;
}

.v2-badge {
  flex: none;
  height: 30rpx;
  margin-right: 10rpx;
  padding: 0 8rpx;
  border-radius: 5rpx;
  background: #C4161C;
  color: #FFFFFF;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 30rpx;
}

.list-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.list-title {
  color: #26282B;
  font-size: 32rpx;
  font-weight: 700;
}

.list-title::before {
  content: "";
  display: inline-block;
  width: 7rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #E23B32, #A8111A);
  vertical-align: -2rpx;
}

.list-count {
  color: #A8A19C;
  font-size: 21rpx;
}

.gov-list {
  padding: 0 24rpx;
}

.gov-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  padding: 26rpx 24rpx;
}

.item-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  color: #C4161C;
  font-size: 34rpx;
  font-weight: 700;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  color: #292B2F;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.item-desc {
  margin-top: 8rpx;
  color: #8C8F94;
  font-size: 23rpx;
  line-height: 1.65;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.mini-tag {
  height: 34rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  background: #F6F2F0;
  color: #948D88;
  font-size: 19rpx;
  line-height: 34rpx;
}

.mini-tag.primary {
  background: #FBEBEB;
  color: #C4161C;
}

.item-arrow {
  flex: none;
  width: 13rpx;
  height: 13rpx;
  margin: 32rpx 4rpx 0 12rpx;
  border-right: 2rpx solid #C9C3BE;
  border-bottom: 2rpx solid #C9C3BE;
  transform: rotate(-45deg);
}

.gov-note {
  display: flex;
  margin: 24rpx 24rpx 0;
  padding: 22rpx 22rpx;
  border: 1rpx solid #EFE8E4;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.note-shield {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #FAF3E3;
  color: #B98430;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}

.note-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.note-title {
  color: #6E625B;
  font-size: 23rpx;
  font-weight: 600;
}

.note-desc {
  margin-top: 4rpx;
  color: #A19A95;
  font-size: 20rpx;
  line-height: 1.7;
}

.gov-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 30rpx 10rpx;
  color: #B1AAA5;
  font-size: 20rpx;
  line-height: 1.9;
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

.item-icon.sk-block {
  border-radius: 22rpx;
}
