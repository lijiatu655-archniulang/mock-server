.profile-page {
  background: #F6F2F0;
}

/* ---------- 身份头部 ---------- */
.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 74rpx;
  background: linear-gradient(148deg, #8E0B11 0%, #B8141B 46%, #CE1F26 78%, #D93A2E 100%);
}

.hero-glow {
  position: absolute;
  top: -170rpx;
  right: -130rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 150, 0.28) 0%, rgba(255, 214, 150, 0) 68%);
}

.hero-lines {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image: repeating-linear-gradient(
    125deg,
    rgba(255, 255, 255, 0.035) 0,
    rgba(255, 255, 255, 0.035) 1rpx,
    transparent 1rpx,
    transparent 22rpx
  );
}

.profile-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  flex: none;
  margin-right: 20rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(155deg, #FFE7B8 0%, #E8B454 100%);
  box-shadow: 0 8rpx 20rpx rgba(80, 5, 8, 0.25);
  color: #8E0F14;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #C4161C;
  border-radius: 50%;
  background: #F2C87E;
  color: #8E0F14;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.identity {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
}

.name {
  max-width: 280rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.role-badge {
  flex: none;
  height: 36rpx;
  margin-left: 12rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
  font-size: 18rpx;
  line-height: 34rpx;
}

.phone-line {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 21rpx;
}

.verify-line {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 19rpx;
}

.verify-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #7BD3A1;
  box-shadow: 0 0 0 4rpx rgba(123, 211, 161, 0.15);
}

.edit-btn {
  flex: none;
  align-self: flex-start;
  height: 48rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.86);
  font-size: 20rpx;
  line-height: 46rpx;
}

.hero-foot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.5);
  font-size: 19rpx;
}

.hero-sep {
  margin: 0 10rpx;
  color: rgba(255, 255, 255, 0.24);
}

/* ---------- 网格卡 ---------- */
.grid-card {
  position: relative;
  z-index: 4;
  margin: -46rpx 24rpx 16rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(94, 42, 37, 0.1);
}

.grid-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-title {
  display: flex;
  align-items: center;
  color: #2F3135;
  font-size: 28rpx;
  font-weight: 700;
}

.pin-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

.grid-verified {
  display: flex;
  align-items: center;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #EDF7F1;
  color: #2F8A59;
  font-size: 18rpx;
}

.grid-verified .dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: #2F8A59;
}

.path-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
}

.path-item {
  height: 42rpx;
  margin-right: 6rpx;
  padding: 0 12rpx;
  border: 1rpx solid #F2E1D8;
  border-radius: 6rpx;
  background: #FFF8F3;
  color: #8A5D44;
  font-size: 21rpx;
  line-height: 40rpx;
}

.path-sep {
  margin-right: 6rpx;
  color: #C8B8AE;
  font-size: 24rpx;
}

.worker-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #F0E7E2;
}

.worker-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.worker-main {
  flex: 1;
  min-width: 0;
}

.worker-name {
  color: #383B3F;
  font-size: 24rpx;
  font-weight: 600;
}

.worker-desc {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 19rpx;
}

.worker-call {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(196, 22, 28, 0.28);
  border-radius: 999rpx;
  color: #C4161C;
  font-size: 21rpx;
}

.phone-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.grid-foot {
  margin-top: 14rpx;
  color: #B0A9A4;
  font-size: 19rpx;
  line-height: 1.6;
}

/* ---------- 数据 ---------- */
.stats-card {
  display: flex;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 0;
}

.stat-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #F3EDEA;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: #C4161C;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}

.stat-label {
  margin-top: 2rpx;
  color: #8E918F;
  font-size: 20rpx;
}

.stat-tag {
  position: absolute;
  top: -4rpx;
  right: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: #F5F0ED;
  color: #A79F99;
  font-size: 15rpx;
  line-height: 26rpx;
}

/* ---------- 菜单 ---------- */
.menu-group {
  margin: 0 24rpx 16rpx;
  padding: 6rpx 24rpx 4rpx;
}

.group-title {
  padding: 18rpx 0 6rpx;
  color: #A19A95;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5EFEC;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-hover {
  background: #FCFAF9;
}

.menu-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-name {
  display: flex;
  align-items: center;
  color: #33363A;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.menu-badge {
  height: 30rpx;
  margin-left: 8rpx;
  padding: 0 7rpx;
  border-radius: 4rpx;
  font-size: 16rpx;
  font-weight: 400;
  line-height: 30rpx;
}

.menu-badge.v2 {
  background: #FBEBEB;
  color: #C4161C;
}

.menu-badge.v3 {
  background: #F1EEF8;
  color: #7563A8;
}

.menu-badge.tel {
  background: #EAF4EE;
  color: #2F8A59;
}

.menu-desc {
  margin-top: 2rpx;
  color: #A19A95;
  font-size: 20rpx;
  line-height: 1.5;
}

.menu-row .arrow {
  margin-left: 12rpx;
}

/* ---------- 退出与页脚 ---------- */
.logout-btn {
  height: 92rpx;
  margin: 24rpx 24rpx 8rpx;
  border: 1rpx solid #F0E7E3;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #C4161C;
  font-size: 26rpx;
  line-height: 90rpx;
  text-align: center;
}

.profile-footer {
  padding: 34rpx 30rpx 24rpx;
  text-align: center;
  color: #B0A9A4;
  font-size: 19rpx;
  line-height: 1.9;
}

.footer-seal {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 8rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #FFE3A9, #E2AF4E);
  color: #8E0F14;
  font-size: 18rpx;
  line-height: 42rpx;
}

.footer-name {
  color: #7C7571;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.footer-icp {
  margin-top: 4rpx;
  color: #C0B9B4;
  font-size: 17rpx;
}

.footer-version {
  margin-top: 6rpx;
  color: #C0B9B4;
  font-size: 17rpx;
}

/* ---------- 登录态 ---------- */
.login-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx 100rpx;
  background: linear-gradient(148deg, #8E0B11 0%, #B8141B 48%, #CE1F26 82%, #D93A2E 100%);
}

.login-glow {
  position: absolute;
  top: -160rpx;
  right: -100rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 150, 0.3) 0%, rgba(255, 214, 150, 0) 68%);
}

.login-seal {
  position: relative;
  z-index: 2;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #FFE7B8, #E2AF4E);
  box-shadow: 0 8rpx 20rpx rgba(80, 5, 8, 0.25);
  color: #8E0F14;
  font-size: 42rpx;
  line-height: 96rpx;
  text-align: center;
}

.login-name {
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  color: #FFFFFF;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.login-slogan {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  color: #FFE4C2;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.login-organizer {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 19rpx;
}

.login-card {
  position: relative;
  z-index: 4;
  margin: -54rpx 24rpx 0;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 24rpx;
}

.login-title {
  color: #26282B;
  font-size: 36rpx;
  font-weight: 700;
}

.login-desc {
  margin-top: 10rpx;
  color: #8E918F;
  font-size: 23rpx;
  line-height: 1.7;
}

.login-tabs {
  display: flex;
  margin-top: 22rpx;
  border-bottom: 1rpx solid #F0E8E4;
}

.login-tab {
  position: relative;
  flex: 1;
  padding: 16rpx 0;
  color: #9A938E;
  font-size: 24rpx;
  text-align: center;
}

.login-tab.active {
  color: #C4161C;
  font-weight: 600;
}

.login-tab.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #C4161C;
  transform: translateX(-50%);
}

.login-form {
  margin-top: 6rpx;
}

.login-field {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid #F3EDEA;
}

.login-field-label {
  flex: none;
  width: 120rpx;
  color: #4B4E53;
  font-size: 23rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  color: #26282B;
  font-size: 25rpx;
}

.login-placeholder {
  color: #B5AEAA;
  font-size: 22rpx;
}

.login-eye {
  flex: none;
  padding-left: 14rpx;
  color: #C4161C;
  font-size: 20rpx;
}

.login-error {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #FFF1EE;
  color: #C4161C;
  font-size: 20rpx;
  line-height: 1.5;
}

.login-demo {
  margin-top: 14rpx;
  color: #A19A95;
  font-size: 18rpx;
  line-height: 1.6;
  text-align: center;
}

.login-btn.loading {
  opacity: 0.7;
}

.login-btn {
  height: 92rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 10rpx 24rpx rgba(196, 22, 28, 0.22);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

.login-note {
  margin-top: 16rpx;
  color: #B0A9A4;
  font-size: 18rpx;
  text-align: center;
}

.login-help {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3EDEA;
  color: #A06A4C;
  font-size: 20rpx;
  text-align: center;
}

.login-footer {
  padding: 34rpx 30rpx;
  text-align: center;
  color: #B0A9A4;
  font-size: 19rpx;
  line-height: 1.9;
}

/* ---------- 关于弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 12, 10, 0.46);
}

.sheet {
  width: 100%;
  padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  animation: sheetUp 0.26s ease both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #E8E0DC;
}

.sheet-seal {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(160deg, #FFE3A9, #E2AF4E);
  color: #8E0F14;
  font-size: 30rpx;
  line-height: 72rpx;
  text-align: center;
}

.sheet-title {
  margin-top: 12rpx;
  color: #26282B;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}

.sheet-version {
  margin-top: 4rpx;
  color: #A19A95;
  font-size: 20rpx;
  text-align: center;
}

.sheet-info {
  margin: 24rpx 0 0;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  background: #FAF7F5;
}

.sheet-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2ECE9;
  font-size: 22rpx;
}

.sheet-row:last-child {
  border-bottom: 0;
}

.sheet-label {
  width: 130rpx;
  color: #A19A95;
}

.sheet-value {
  flex: 1;
  color: #4B4E53;
  text-align: right;
}

.sheet-desc {
  margin-top: 20rpx;
  color: #8E918F;
  font-size: 21rpx;
  line-height: 1.8;
}

.sheet-btn {
  height: 86rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 86rpx;
  text-align: center;
}

/* ---------- 骨架 ---------- */
.sk-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.sk-block {
  background: linear-gradient(90deg, #EFEAE7 25%, #FAF7F5 37%, #EFEAE7 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s ease infinite;
}

.sk-block.light {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 25%, rgba(255, 255, 255, 0.3) 37%, rgba(255, 255, 255, 0.16) 63%);
  background-size: 400% 100%;
}
