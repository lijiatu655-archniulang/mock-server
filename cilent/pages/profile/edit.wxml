<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="page edit-page">
  <view class="edit-head">
    <view class="head-title">{{i18n.t('修改资料', lang)}}</view>
    <view class="head-sub">{{i18n.t('头像和昵称只用于平台内展示，实名信息由村委核验。', lang)}}</view>
  </view>

  <view class="avatar-card card">
    <view class="avatar-label">{{i18n.t('头像', lang)}}</view>
    <view class="avatar-row">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" hover-class="press">
        <image
          wx:if="{{avatarPreview && !avatarFailed}}"
          class="avatar-img"
          src="{{avatarPreview}}"
          mode="aspectFill"
          binderror="onAvatarError"
        ></image>
        <view wx:else class="avatar-fallback">{{user.avatarText || i18n.t('村', lang)}}</view>
        <view class="avatar-camera">{{i18n.t('拍照', lang)}}</view>
      </button>
      <view class="avatar-tip">
        <view>{{i18n.t('点击左侧头像可直接用微信头像', lang)}}</view>
        <view class="avatar-link" bindtap="onChooseFromAlbum">{{i18n.t('或从相册选择 ›', lang)}}</view>
        <view class="avatar-link reset" wx:if="{{avatarPreview}}" bindtap="onRestoreAvatar">{{i18n.t('恢复默认头像', lang)}}</view>
      </view>
    </view>
  </view>

  <view class="form-card card">
    <view class="field">
      <view class="field-label">
        <text>{{i18n.t('昵称', lang)}}</text>
        <text class="field-count">{{nickname.length}}/12</text>
      </view>
      <input
        class="field-input"
        value="{{nickname}}"
        maxlength="12"
        bindinput="onNicknameInput"
        placeholder="{{i18n.t('请输入 2—12 个字的昵称', lang)}}"
        placeholder-class="field-placeholder"
      />
    </view>

    <view class="readonly-title">{{i18n.t('实名信息（不可修改）', lang)}}</view>
    <view class="readonly-row">
      <text class="readonly-label">{{i18n.t('姓名', lang)}}</text>
      <text class="readonly-value">{{user.name}}</text>
      <text class="readonly-tag">{{i18n.t('已核验', lang)}}</text>
    </view>
    <view class="readonly-row">
      <text class="readonly-label">{{i18n.t('手机号', lang)}}</text>
      <text class="readonly-value">{{user.phoneDisplay}}</text>
    </view>
    <view class="readonly-row">
      <text class="readonly-label">{{i18n.t('所属区域', lang)}}</text>
      <text class="readonly-value">{{regionText}}</text>
    </view>
    <view class="readonly-row">
      <text class="readonly-label">{{i18n.t('网格', lang)}}</text>
      <text class="readonly-value">{{user.gridName}}</text>
    </view>
    <view class="readonly-row readonly-last">
      <text class="readonly-label">{{i18n.t('门牌', lang)}}</text>
      <text class="readonly-value">{{user.houseNo}}</text>
    </view>
    <view class="readonly-note">{{i18n.t('实名信息如需修改，请携带身份证到村党群服务中心办理。', lang)}}</view>

    <view class="form-error" wx:if="{{error}}">{{error}}</view>
  </view>

  <view class="save-btn {{saving ? 'loading' : ''}} {{dirty ? '' : 'disabled'}}" bindtap="onSave" hover-class="press">
    {{saving ? i18n.t('保存中…', lang) : i18n.t('保存', lang)}}
  </view>
  <view class="save-tip">{{i18n.t('头像和昵称保存后立即生效', lang)}}</view>
</view>
