.edit-page {
  background: #F6F2F0;
}

.edit-head {
  padding: 34rpx 30rpx 24rpx;
  background: linear-gradient(180deg, #FFF8F3 0%, #F6F2F0 100%);
}

.head-title {
  color: #24262A;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 8rpx;
  color: #9A938E;
  font-size: 21rpx;
  line-height: 1.65;
}

.avatar-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 26rpx;
}

.avatar-label {
  margin-bottom: 14rpx;
  color: #4B4E53;
  font-size: 23rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
}

.avatar-btn {
  position: relative;
  flex: none;
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(155deg, #FFE7B8, #E8B454);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  color: #8E0F14;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 128rpx;
  text-align: center;
}

.avatar-camera {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34rpx;
  background: rgba(20, 10, 8, 0.5);
  color: #FFFFFF;
  font-size: 17rpx;
  line-height: 34rpx;
  text-align: center;
}

.avatar-tip {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  color: #8C8F94;
  font-size: 21rpx;
  line-height: 1.7;
}

.avatar-link {
  margin-top: 6rpx;
  color: #C4161C;
  font-size: 21rpx;
}

.avatar-link.reset {
  color: #A19A95;
  font-size: 19rpx;
}

.form-card {
  margin: 0 24rpx 16rpx;
  padding: 26rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-last {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  color: #4B4E53;
  font-size: 23rpx;
}

.field-count {
  margin-left: auto;
  color: #B5AEAA;
  font-size: 18rpx;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 18rpx;
  border: 1rpx solid #EDE4DF;
  border-radius: 12rpx;
  background: #FBF8F6;
  color: #33363A;
  font-size: 26rpx;
}

.field-placeholder {
  color: #B5AEAA;
  font-size: 23rpx;
}

.readonly-title {
  padding: 22rpx 0 6rpx;
  border-top: 1rpx solid #F3EDEA;
  color: #34363A;
  font-size: 23rpx;
  font-weight: 600;
}

.readonly-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5EFEC;
}

.readonly-row.readonly-last {
  border-bottom: 0;
}

.readonly-label {
  flex: none;
  width: 140rpx;
  color: #9A938E;
  font-size: 22rpx;
}

.readonly-value {
  flex: 1;
  min-width: 0;
  color: #4B4E53;
  font-size: 24rpx;
  word-break: break-all;
}

.readonly-tag {
  flex: none;
  margin-left: 10rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  background: #EAF4EE;
  color: #2F8A59;
  font-size: 17rpx;
  line-height: 32rpx;
}

.readonly-note {
  margin-top: 10rpx;
  color: #A19A95;
  font-size: 19rpx;
  line-height: 1.6;
}

.form-error {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #FFF1EE;
  color: #C4161C;
  font-size: 21rpx;
}

.save-btn {
  height: 88rpx;
  margin: 8rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 20rpx rgba(196, 22, 28, 0.22);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.save-btn.loading {
  opacity: 0.7;
}

.save-btn.disabled {
  background: #D8D2CE;
  box-shadow: none;
  color: #FFFFFF;
}

.save-tip {
  padding: 0 30rpx 20rpx;
  color: #B0A9A4;
  font-size: 18rpx;
  text-align: center;
}
