<view class="page profile-page" wx:if="{{loading && !user}}">
  <view class="profile-hero">
    <view class="hero-glow"></view>
    <view class="profile-top">
      <view class="sk-avatar"></view>
      <view class="identity">
        <view class="sk-block light" style="width:180rpx;height:40rpx;"></view>
        <view class="sk-block light" style="width:300rpx;height:24rpx;margin-top:16rpx;"></view>
        <view class="sk-block light" style="width:240rpx;height:24rpx;margin-top:12rpx;"></view>
      </view>
    </view>
  </view>
  <view class="grid-card card">
    <view class="sk-block" style="width:150rpx;height:32rpx;"></view>
    <view class="sk-block" style="width:70%;height:26rpx;margin-top:22rpx;"></view>
    <view class="sk-block" style="width:90%;height:80rpx;margin-top:22rpx;"></view>
  </view>
</view>

<view class="page profile-page" wx:elif="{{!loggedIn}}">
  <view class="login-hero">
    <image class="login-hero-photo" src="/assets/images/home/hero-village.jpg" mode="aspectFill"></image>
    <view class="login-glow"></view>
    <view class="login-seal">★</view>
    <view class="login-name">新源村情通</view>
    <view class="login-slogan">听民意 · 解民忧 · 暖民心</view>
    <view class="login-features">
      <text>实名认证</text>
      <text>村务公开</text>
      <text>在线办事</text>
    </view>
  </view>
  <view class="login-card card">
    <view class="login-title">欢迎回来</view>
    <view class="login-tabs">
      <view
        class="login-tab {{loginMode === 'wechat' ? 'active' : ''}}"
        data-mode="wechat"
        bindtap="onLoginMode"
      >微信登录</view>
      <view
        class="login-tab {{loginMode === 'password' ? 'active' : ''}}"
        data-mode="password"
        bindtap="onLoginMode"
      >账号密码</view>
    </view>

    <block wx:if="{{loginMode === 'wechat'}}">
      <view class="login-desc">使用微信身份快速登录，登录后可使用我的办件、诉求建议等服务。</view>
      <view class="login-btn" bindtap="onLogin" hover-class="press">微信一键登录</view>
    </block>

    <block wx:else>
      <view class="login-desc">使用手机号和密码登录，适合不方便使用微信授权的场景。</view>
      <view class="role-switch">
        <view
          class="role-item {{loginRole === 'villager' ? 'active' : ''}}"
          data-role="villager"
          bindtap="onLoginRole"
        >居民</view>
        <view
          class="role-item {{loginRole === 'admin' ? 'active' : ''}}"
          data-role="admin"
          bindtap="onLoginRole"
        >管理员</view>
      </view>
      <view class="login-form">
        <view class="login-field">
          <text class="login-field-label">手机号</text>
          <input
            class="login-input"
            type="text"
            maxlength="20"
            value="{{account}}"
            bindinput="onAccountInput"
            placeholder="请输入手机号或账号"
            placeholder-class="login-placeholder"
          />
        </view>
        <view class="login-field">
          <text class="login-field-label">密码</text>
          <input
            class="login-input"
            password="{{!showPassword}}"
            maxlength="20"
            value="{{password}}"
            bindinput="onPasswordInput"
            bindconfirm="onAccountLogin"
            confirm-type="done"
            placeholder="请输入密码"
            placeholder-class="login-placeholder"
          />
          <view class="login-eye" bindtap="onTogglePassword">{{showPassword ? '隐藏' : '显示'}}</view>
        </view>
        <view class="login-error" wx:if="{{loginError}}">{{loginError}}</view>
        <view class="login-btn {{loginLoading ? 'loading' : ''}}" bindtap="onAccountLogin" hover-class="press">
          {{loginLoading ? '登录中…' : (loginRole === 'admin' ? '进入管理员工作台' : '登录')}}
        </view>
        <view class="login-demo" wx:if="{{loginRole === 'admin'}}">管理员演示：13843219072　密码：123456</view>
        <view class="login-demo" wx:else>居民演示：13843216621　密码：123456</view>
      </view>
    </block>

    <view class="login-note">登录即代表同意《用户协议》与《隐私政策》</view>
    <view class="login-help" bindtap="onCallHotline">登录遇到问题？拨打 0432-64216888</view>
  </view>
  <view class="login-footer">
    <view>新源村党群服务中心</view>
    <view>本平台为村级政务服务演示版本</view>
  </view>
</view>

<view class="page profile-page" wx:else>
  <view class="profile-hero">
    <image class="profile-hero-photo" src="/assets/images/home/hero-village.jpg" mode="aspectFill"></image>
    <view class="hero-glow"></view>
    <view class="hero-lines"></view>
    <view class="profile-top">
      <view class="avatar-wrap">
        <view class="avatar-shell" style="width:112rpx;height:112rpx;border-radius:50%;overflow:hidden;">
          <view wx:if="{{!user.avatarUrl || avatarFailed}}" class="avatar-fallback">{{user.avatarText}}</view>
          <image
            wx:else
            class="avatar-photo"
            style="position:absolute;top:0;left:0;width:100%;height:100%;"
            src="{{user.avatarUrl}}"
            mode="aspectFill"
            binderror="onAvatarError"
          ></image>
        </view>
        <view class="avatar-badge">✓</view>
      </view>
      <view class="identity">
        <view class="name-row">
          <text class="name">{{user.displayName}}</text>
          <view class="role-badge">{{user.roleName}}</view>
        </view>
        <view class="phone-line">{{user.phoneDisplay}} · {{user.houseNo}}</view>
        <view class="verify-line">
          <view class="verify-dot"></view>
          <text>已实名认证 · 由村委核验</text>
        </view>
      </view>
      <view class="edit-btn" bindtap="onEditProfile" hover-class="press">修改</view>
    </view>
    <view class="hero-foot">
      <text>{{user.joinedText}}</text>
      <text class="hero-sep">·</text>
      <text>新源村情通 V{{version}}</text>
    </view>
  </view>

  <view class="stats-card card">
    <view
      class="stat-item"
      wx:for="{{user.statList}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onStatsTap"
      hover-class="press"
    >
      <view class="stat-top">
        <text class="stat-value">{{item.value}}</text>
        <view class="stat-icon" style="background:{{item.tint}};color:{{item.color}};">{{item.icon}}</view>
      </view>
      <view class="stat-label">{{item.label}}</view>
      <view class="stat-tag" wx:if="{{item.badge}}">{{item.badge}}</view>
    </view>
  </view>

  <view class="admin-entry" wx:if="{{user.isAdmin}}" bindtap="onAdminWorkbench" hover-class="press">
    <view class="admin-entry-main">
      <view class="admin-entry-title">管理员工作台</view>
      <view class="admin-entry-desc">通知发布 · 诉求受理 · 户籍统计</view>
    </view>
    <view class="admin-entry-arrow">›</view>
  </view>

  <view class="grid-card card">
    <view class="grid-head">
      <view class="grid-title">
        <image class="pin-icon" src="/assets/icons/icon-pin.png" mode="aspectFit"></image>
        <text>我的网格</text>
      </view>
      <view class="grid-verified">
        <view class="dot"></view>
        <text>已认证</text>
      </view>
    </view>

    <view class="path-row" wx:if="{{user.regionPath.length}}">
      <block wx:for="{{user.regionPath}}" wx:key="*this" wx:for-item="path" wx:for-index="pi">
        <text class="path-item">{{path}}</text>
        <text class="path-sep" wx:if="{{pi < user.regionPath.length - 1}}">›</text>
      </block>
    </view>

    <view class="worker-row" wx:if="{{user.gridWorker}}">
      <view class="worker-avatar">{{user.gridWorker.initial}}</view>
      <view class="worker-main">
        <view class="worker-name">网格员 {{user.gridWorker.name}}</view>
        <view class="worker-desc">{{user.gridWorker.phoneDisplay}} · {{user.gridWorker.duty}}</view>
      </view>
      <view class="worker-call" bindtap="onCallWorker" hover-class="press">
        <image class="phone-icon" src="/assets/icons/icon-phone.png" mode="aspectFit"></image>
        <text>拨打</text>
      </view>
    </view>

    <view class="grid-foot">有困难找网格员，行动不便可预约上门代办</view>
  </view>

  <view class="menu-group card" wx:for="{{menuGroups}}" wx:key="title" wx:for-item="group">
    <view class="group-title">{{group.title}}</view>
    <view
      class="menu-row"
      wx:for="{{group.items}}"
      wx:key="code"
      wx:for-item="row"
      data-action="{{row.action}}"
      data-name="{{row.name}}"
      data-version="{{row.version}}"
      data-desc-text="{{row.descText}}"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <view class="menu-icon" style="background:{{row.tint}};color:{{row.color}};">{{row.icon}}</view>
      <view class="menu-main">
        <view class="menu-name">
          <text>{{row.name}}</text>
          <text class="menu-badge {{row.badgeType}}" wx:if="{{row.badge}}">{{row.badge}}</text>
        </view>
        <view class="menu-desc">{{row.desc}}</view>
      </view>
      <view class="arrow"></view>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout" wx:if="{{loggedIn}}">退出登录</view>

  <view class="profile-footer">
    <view class="footer-seal">★</view>
    <view class="footer-name">新源村情通</view>
    <view class="footer-version">V{{version}} · 村级政务服务演示版本</view>
  </view>

  <view class="sheet-mask" wx:if="{{showAbout}}" bindtap="closeAbout">
    <view class="sheet" catchtap="noop">
      <view class="sheet-bar"></view>
      <view class="sheet-seal">★</view>
      <view class="sheet-title">新源村情通</view>
      <view class="sheet-version">V{{version}} · 村级事务服务平台</view>
      <view class="sheet-desc">当前已开放村情资讯、AI 网格员、政务在线申报、诉求建议、服务黄页、招聘、线上奶茶会和家庭成员；管理员账号可进入工作台处理通知、诉求和户籍统计。</view>
      <view class="sheet-btn" bindtap="closeAbout" hover-class="press">知道了</view>
    </view>
  </view>
</view>
