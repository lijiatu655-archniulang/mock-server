<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="rd-page">
  <view class="rd-head">
    <view class="rd-back" bindtap="onBack" hover-class="press">‹</view>
    <view class="rd-head-main">
      <view class="rd-title">{{i18n.t('诉求详情', lang)}}</view>
      <view class="rd-sub">{{i18n.t('管理员处理', lang)}}</view>
    </view>
    <view class="rd-refresh" bindtap="onRefresh" hover-class="press">{{i18n.t('刷新', lang)}}</view>
  </view>

  <view class="rd-loading" wx:if="{{loading}}">{{i18n.t('加载中…', lang)}}</view>
  <view class="rd-error" wx:elif="{{error}}">{{error}}</view>

  <block wx:elif="{{request}}">
    <view class="rd-hero">
      <view class="rd-status {{request.status}}">{{request.statusLabel || request.status}}</view>
      <view class="rd-type">{{request.typeLabel}} · {{request.requestNo}}</view>
      <view class="rd-title-text">{{request.title}}</view>
      <view class="rd-meta">{{request.userName || i18n.t('村民', lang)}} · {{request.createdAt}}</view>
    </view>

    <view class="rd-card">
      <view class="rd-section-title">{{i18n.t('诉求内容', lang)}}</view>
      <view class="rd-content">{{request.content}}</view>
      <view class="rd-location" wx:if="{{request.location}}">地点：{{request.location}}</view>
      <view class="rd-phone" wx:if="{{request.contactPhone}}">联系电话：{{request.contactPhone}}</view>
      <view class="rd-photos" wx:if="{{request.photos.length}}">
        <image
          class="rd-photo"
          wx:for="{{request.photos}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="onPreviewPhoto"
        ></image>
      </view>
    </view>

    <view class="rd-card">
      <view class="rd-section-title">{{i18n.t('办理时间轴', lang)}}</view>
      <view class="rd-timeline" wx:if="{{request.logs.length}}">
        <view class="rd-log" wx:for="{{request.logs}}" wx:key="timeText">
          <view class="rd-log-dot {{index === request.logs.length - 1 ? 'active' : ''}}"></view>
          <view class="rd-log-body">
            <view class="rd-log-top">
              <text class="rd-log-label">{{item.label}}</text>
              <text class="rd-log-time">{{item.timeText}}</text>
            </view>
            <view class="rd-log-note">{{item.note}}</view>
            <view class="rd-log-operator" wx:if="{{item.operator}}">经办：{{item.operator}}</view>
          </view>
        </view>
      </view>
      <view class="rd-empty" wx:else>{{i18n.t('暂无办理记录', lang)}}</view>
    </view>

    <view class="rd-card" wx:if="{{request.replies.length}}">
      <view class="rd-section-title">{{i18n.t('办理回复', lang)}}</view>
      <view class="rd-reply" wx:for="{{request.replies}}" wx:key="timeText">
        <view class="rd-reply-top">
          <text class="rd-reply-operator">{{item.operator || i18n.t('村委会', lang)}}</text>
          <text class="rd-reply-time">{{item.timeText}}</text>
        </view>
        <view class="rd-reply-content">{{item.content}}</view>
      </view>
    </view>

    <view class="rd-actions">
      <view
        class="rd-btn primary"
        wx:if="{{request.status === 'PENDING'}}"
        bindtap="onAccept"
        hover-class="press"
      >{{actionLoading ? i18n.t('处理中…', lang) : i18n.t('受理诉求', lang)}}</view>
      <block wx:if="{{request.status === 'ACCEPTED' || request.status === 'PROCESSING'}}">
        <view class="rd-btn" bindtap="onReplyOpen" hover-class="press">{{i18n.t('回复居民', lang)}}</view>
        <view class="rd-btn primary" bindtap="onComplete" hover-class="press">{{i18n.t('办结', lang)}}</view>
      </block>
      <view class="rd-done" wx:if="{{request.status === 'COMPLETED'}}">{{i18n.t('该诉求已办结', lang)}}</view>
    </view>
  </block>

  <view class="rd-mask" wx:if="{{replyOpen}}" bindtap="onReplyClose">
    <view class="rd-sheet" catchtap="noop">
      <view class="rd-sheet-title">{{i18n.t('回复居民', lang)}}</view>
      <textarea
        class="rd-textarea"
        value="{{replyContent}}"
        maxlength="500"
        placeholder="{{i18n.t('请填写办理结果，居民端会同步看到', lang)}}"
        placeholder-class="rd-placeholder"
        bindinput="onReplyInput"
      ></textarea>
      <view class="rd-count">{{replyContent.length}}/500</view>
      <view class="rd-image-block">
        <view class="rd-image-label">
          <text>{{i18n.t('现场/办理图片', lang)}}</text>
          <text class="rd-image-reserved">{{i18n.t('预留位 · 后端暂未接收', lang)}}</text>
        </view>
        <view class="rd-image-grid">
          <view class="rd-image-item" wx:for="{{replyImages}}" wx:key="*this">
            <image class="rd-image-thumb" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewReplyImage"></image>
            <view class="rd-image-del" data-index="{{index}}" catchtap="removeReplyImage">×</view>
          </view>
          <view class="rd-image-add" wx:if="{{replyImages.length < 3}}" bindtap="chooseReplyImages" hover-class="press">
            <text class="rd-image-plus">＋</text>
            <text class="rd-image-text">{{i18n.t('添加图片', lang)}}</text>
          </view>
        </view>
      </view>
      <view class="rd-sheet-actions">
        <view class="rd-cancel" bindtap="onReplyClose">{{i18n.t('取消', lang)}}</view>
        <view class="rd-save {{actionLoading ? 'loading' : ''}}" bindtap="onReplySubmit">{{actionLoading ? i18n.t('提交中…', lang) : i18n.t('提交回复', lang)}}</view>
      </view>
    </view>
  </view>
</view>
