<view class="page request-create-page">
  <view class="create-head">
    <view class="head-title">有事您说话</view>
    <view class="head-sub">村里的事，件件有回音；紧急情况请直接拨打 110 / 120。</view>
  </view>

  <view class="type-tabs">
    <view
      class="type-tab {{type === item.value ? 'on' : ''}}"
      wx:for="{{types}}"
      wx:key="value"
      data-type="{{item.value}}"
      bindtap="onTypeTap"
      hover-class="press"
    >
      <view class="type-name">{{item.name}}</view>
      <view class="type-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="form-card card">
    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <view class="field">
      <view class="field-label">
        <text>标题</text>
        <text class="required">*</text>
        <text class="field-count">{{title.length}}/40</text>
      </view>
      <input
        class="field-input"
        value="{{title}}"
        data-field="title"
        bindinput="onInput"
        maxlength="40"
        placeholder="一句话说清是什么事"
        placeholder-class="field-placeholder"
      />
    </view>

    <view class="field">
      <view class="field-label">
        <text>具体情况</text>
        <text class="required">*</text>
        <text class="field-count">{{content.length}}/300</text>
      </view>
      <textarea
        class="field-textarea"
        value="{{content}}"
        data-field="content"
        bindinput="onInput"
        maxlength="300"
        auto-height
        placeholder="时间、地点、经过，写得越清楚，处理越快"
        placeholder-class="field-placeholder"
      ></textarea>
    </view>

    <view class="field">
      <view class="field-label">
        <text>地点</text>
        <text class="field-optional">选填</text>
      </view>
      <input
        class="field-input"
        value="{{location}}"
        data-field="location"
        bindinput="onInput"
        maxlength="50"
        placeholder="如：三组 26 号东侧"
        placeholder-class="field-placeholder"
      />
    </view>

    <view class="field">
      <view class="field-label">
        <text>联系电话</text>
        <text class="field-optional">选填，便于回电</text>
      </view>
      <input
        class="field-input"
        value="{{contactPhone}}"
        data-field="contactPhone"
        bindinput="onInput"
        type="number"
        maxlength="11"
        placeholder="不会填可留空，网格员会通过微信联系您"
        placeholder-class="field-placeholder"
      />
    </view>

    <view class="field field-last">
      <view class="field-label">
        <text>现场照片</text>
        <text class="field-optional">选填，最多 3 张</text>
      </view>
      <view class="photo-row">
        <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
          <image class="photo-img" src="{{item}}" mode="aspectFill"></image>
          <view class="photo-del" data-index="{{index}}" bindtap="onRemovePhoto">×</view>
        </view>
        <view class="photo-add" wx:if="{{photos.length < 3}}" bindtap="onChoosePhoto" hover-class="press">
          <view class="photo-plus">＋</view>
          <text>添加照片</text>
        </view>
      </view>
    </view>
  </view>

  <view class="privacy-tip">
    <view class="privacy-dot"></view>
    <text>您的信息仅用于本次办理，不会公开；如需匿名，可在内容中说明。</text>
  </view>

  <view class="create-footer">
    <view class="footer-note">提交后可在「我的诉求」查看办理进度</view>
    <view class="submit-btn {{submitting ? 'loading' : ''}}" bindtap="onSubmit" hover-class="press">
      {{submitting ? '正在提交…' : '提交' + typeName}}
    </view>
  </view>
</view>
