<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="family-page">
  <view class="family-head">
    <view class="family-back" bindtap="onBack" hover-class="press">‹</view>
    <view class="family-head-main">
      <view class="family-title">{{i18n.t('我的家庭', lang)}}</view>
      <view class="family-sub">{{i18n.t('父母、配偶、子女信息维护', lang)}}</view>
    </view>
    <view class="family-add" bindtap="openAdd" hover-class="press">{{i18n.t('＋ 添加', lang)}}</view>
  </view>

  <view class="family-intro">
    <view class="intro-icon">{{i18n.t('家', lang)}}</view>
    <view class="intro-main">
      <view class="intro-title">{{i18n.t('家庭成员仅本人可见', lang)}}</view>
      <view class="intro-desc">{{i18n.t('用于后续代办、家庭成员业务，新增或修改后立即生效。', lang)}}</view>
    </view>
  </view>

  <view class="family-loading" wx:if="{{loading}}">{{i18n.t('加载中…', lang)}}</view>
  <view class="family-error" wx:elif="{{error}}">{{error}}</view>

  <block wx:elif="{{list.length}}">
    <view class="member-card" wx:for="{{list}}" wx:key="id">
      <view class="member-avatar">{{item.initial}}</view>
      <view class="member-main">
        <view class="member-top">
          <text class="member-name">{{item.name}}</text>
          <text class="member-relation">{{item.relation ? i18n.t(item.relation, lang) : i18n.t('家庭成员', lang)}}</text>
          <text class="guardian-tag" wx:if="{{item.isGuardian}}">{{i18n.t('监护人', lang)}}</text>
        </view>
        <view class="member-meta">
          {{item.gender ? i18n.t(item.gender, lang) : '—'}}<text wx:if="{{item.age !== null && item.age !== undefined}}"> · {{item.age}} {{i18n.t('岁', lang)}}</text>
        </view>
        <view class="member-line" wx:if="{{item.phone}}">{{i18n.t('电话：', lang)}}{{item.phone}}</view>
        <view class="member-line" wx:if="{{item.idCardMasked}}">{{i18n.t('证件：', lang)}}{{item.idCardMasked}}</view>
      </view>
      <view class="member-actions">
        <view class="member-btn" data-id="{{item.id}}" bindtap="openEdit">{{i18n.t('编辑', lang)}}</view>
        <view class="member-btn danger" data-id="{{item.id}}" bindtap="remove">{{i18n.t('删除', lang)}}</view>
      </view>
    </view>
  </block>

  <view class="family-empty" wx:else>
    <view class="empty-icon">{{i18n.t('家', lang)}}</view>
    <view class="empty-title">{{i18n.t('还没有家庭成员', lang)}}</view>
    <view class="empty-desc">{{i18n.t('添加父母、配偶或子女，方便后续代办村里的事。', lang)}}</view>
    <view class="empty-btn" bindtap="openAdd">{{i18n.t('添加第一位成员', lang)}}</view>
  </view>

  <view class="family-mask" wx:if="{{formOpen}}" bindtap="closeForm">
    <view class="family-sheet" catchtap="noop">
      <view class="sheet-title">{{form.id ? i18n.t('编辑家庭成员', lang) : i18n.t('添加家庭成员', lang)}}</view>
      <scroll-view class="sheet-scroll" scroll-y>
        <view class="form-field">
          <text class="form-label">{{i18n.t('姓名', lang)}}<text class="required">*</text></text>
          <input
            class="form-input"
            value="{{form.name}}"
            maxlength="20"
            placeholder="{{i18n.t('请输入成员姓名', lang)}}"
            placeholder-class="form-placeholder"
            data-field="name"
            bindinput="onField"
          />
        </view>
        <view class="form-field">
          <text class="form-label">{{i18n.t('关系', lang)}}</text>
          <picker mode="selector" range="{{lang === 'ko' ? relationsKo : relations}}" value="{{relationIndex}}" bindchange="onRelationChange">
            <view class="form-picker">{{i18n.t(form.relation, lang)}} <text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="form-field">
          <text class="form-label">{{i18n.t('性别', lang)}}</text>
          <picker mode="selector" range="{{lang === 'ko' ? gendersKo : genders}}" value="{{genderIndex}}" bindchange="onGenderChange">
            <view class="form-picker">{{i18n.t(form.gender, lang)}} <text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="form-field">
          <text class="form-label">{{i18n.t('年龄', lang)}}</text>
          <input
            class="form-input"
            type="number"
            value="{{form.age}}"
            maxlength="3"
            placeholder="{{i18n.t('请输入年龄', lang)}}"
            placeholder-class="form-placeholder"
            data-field="age"
            bindinput="onField"
          />
        </view>
        <view class="form-field">
          <text class="form-label">{{i18n.t('电话', lang)}}</text>
          <input
            class="form-input"
            type="number"
            value="{{form.phone}}"
            maxlength="11"
            placeholder="{{i18n.t('请输入联系电话', lang)}}"
            placeholder-class="form-placeholder"
            data-field="phone"
            bindinput="onField"
          />
        </view>
        <view class="form-field">
          <text class="form-label">{{i18n.t('证件号', lang)}}</text>
          <input
            class="form-input"
            value="{{form.idCardMasked}}"
            maxlength="24"
            placeholder="{{i18n.t('可填脱敏证件号', lang)}}"
            placeholder-class="form-placeholder"
            data-field="idCardMasked"
            bindinput="onField"
          />
        </view>
        <view class="form-switch-row">
          <view>
            <view class="form-label">{{i18n.t('设为监护人', lang)}}</view>
            <view class="form-hint">{{i18n.t('用于后续为家人代办业务', lang)}}</view>
          </view>
          <switch checked="{{form.isGuardian === 1}}" color="#C4161C" bindchange="onGuardianChange" />
        </view>
      </scroll-view>
      <view class="sheet-actions">
        <view class="sheet-cancel" bindtap="closeForm">{{i18n.t('取消', lang)}}</view>
        <view class="sheet-save {{saving ? 'loading' : ''}}" bindtap="save">{{saving ? i18n.t('保存中…', lang) : i18n.t('保存', lang)}}</view>
      </view>
    </view>
  </view>
</view>
