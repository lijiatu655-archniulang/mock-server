.ai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #F4F0EE;
}

/* ---------- 顶部身份 ---------- */
.ai-head {
  flex: none;
  padding: 20rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #F0E8E4;
  background: linear-gradient(180deg, #FFF9F5 0%, #F7F2EF 100%);
}

.head-row {
  display: flex;
  align-items: center;
}

.ai-avatar {
  position: relative;
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 18rpx;
  border: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  box-shadow: 0 8rpx 20rpx rgba(94, 23, 18, 0.28);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 90rpx;
  text-align: center;
}

.ai-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-dot {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  background: #2FA35A;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-name {
  display: flex;
  align-items: center;
  color: #26282B;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.online-dot {
  width: 8rpx;
  height: 8rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #2FA35A;
}

.online-text {
  margin-left: 5rpx;
  color: #2FA35A;
  font-size: 18rpx;
  font-weight: 400;
}

.head-desc {
  margin-top: 2rpx;
  color: #9A938E;
  font-size: 20rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  flex: none;
}

.history-btn {
  height: 52rpx;
  padding: 0 14rpx;
  border: 1rpx solid #EFE2DC;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #8A6A58;
  font-size: 19rpx;
  line-height: 50rpx;
}

.new-chat {
  flex: none;
  height: 56rpx;
  margin-left: 10rpx;
  padding: 0 16rpx;
  border: 1rpx solid #EFE2DC;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(94, 42, 37, 0.04);
  color: #C4161C;
  font-size: 20rpx;
  line-height: 54rpx;
}

/* 右上角声音开关 */
.tts-btn {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 8rpx;
  border: 1rpx solid #EFE2DC;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(94, 42, 37, 0.04);
  line-height: 1;
}

.tts-btn.on {
  border-color: rgba(196, 22, 28, 0.3);
  background: #FBEBEB;
}

.tts-btn.speaking {
  border-color: #C4161C;
  background: #C4161C;
  box-shadow: 0 0 0 6rpx rgba(196, 22, 28, 0.12);
}

.tts-icon {
  font-size: 26rpx;
  line-height: 1;
}

.tts-btn.speaking .tts-icon {
  animation: ttsPulse 1s ease-in-out infinite;
}

@keyframes ttsPulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.12);
    opacity: 0.82;
  }
}

.tool-chip.reading {
  border-color: #C4161C;
  background: #C4161C;
  color: #FFFFFF;
}

.head-promise {
  display: flex;
  align-items: center;
  margin: 14rpx 0 0 100rpx;
  color: #A06A4C;
  font-size: 19rpx;
}

.promise-dot {
  width: 6rpx;
  height: 6rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #D9A15E;
}

/* ---------- 对话区 ---------- */
.chat-scroll {
  flex: 1;
  height: 0;
}

.scroll-bottom {
  position: fixed;
  right: 24rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  z-index: 18;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid #F0E2DB;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(94, 42, 37, 0.12);
  color: #C4161C;
  font-size: 20rpx;
}

.scroll-arrow {
  margin-left: 6rpx;
  font-size: 18rpx;
}

.chat-inner {
  padding: 22rpx 24rpx 12rpx;
}

.date-line {
  display: flex;
  justify-content: center;
  margin-bottom: 22rpx;
}

.date-text {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #A8A19C;
  font-size: 18rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 26rpx;
}

.user-row {
  align-items: flex-start;
  justify-content: flex-end;
  padding-left: 68rpx;
}

.user-avatar {
  margin-right: 0;
  margin-left: 10rpx;
  background: linear-gradient(150deg, #F4D8C9, #E3B49C);
  color: #7A3B22;
}

.user-bubble {
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  background: linear-gradient(135deg, #D21F24 0%, #B0141B 100%);
  box-shadow: 0 8rpx 20rpx rgba(196, 22, 28, 0.18);
  color: #FFFFFF;
}

.ai-row {
  align-items: flex-start;
}

.msg-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin-top: 2rpx;
  margin-right: 14rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(140deg, #E44432, #A8111A);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
}

.ai-msg-avatar {
  border: 0;
  background: transparent;
  box-shadow: 0 4rpx 12rpx rgba(94, 23, 18, 0.18);
}

.msg-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.ai-bubble {
  padding: 20rpx 22rpx;
  border: 1rpx solid #F1E8E3;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(94, 42, 37, 0.045);
  color: #3C3F44;
}

.error-bubble {
  border-color: #F2D8CE;
  background: #FFF9F6;
}

.typing {
  display: flex;
  align-items: center;
  color: #9A938E;
  font-size: 24rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  margin-right: 10rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 5rpx;
  border-radius: 50%;
  background: #C4161C;
  animation: typing 1.1s ease infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typing {
  0%,
  100% {
    opacity: 0.2;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-3rpx);
  }
}

.stream-cursor {
  margin-left: 2rpx;
  color: #C4161C;
  font-size: 26rpx;
  animation: blink 0.8s step-end infinite;
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

.stopped-note {
  margin-top: 10rpx;
  color: #B4ADA8;
  font-size: 19rpx;
}

.degraded-note {
  margin-top: 10rpx;
  color: #B07A54;
  font-size: 19rpx;
}

/* ---------- 引用 ---------- */
.refs {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #F0E7E2;
}

.refs-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  color: #B07A54;
  font-size: 19rpx;
}

.refs-line {
  width: 18rpx;
  height: 2rpx;
  margin-right: 8rpx;
  background: #D9A15E;
}

.ref-card {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #FAF6F3;
}

.ref-type {
  flex: none;
  width: 44rpx;
  height: 38rpx;
  margin-right: 10rpx;
  border-radius: 5rpx;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 17rpx;
  line-height: 38rpx;
  text-align: center;
}

.ref-main {
  flex: 1;
  min-width: 0;
}

.ref-title {
  color: #494237;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}

.ref-source {
  margin-top: 2rpx;
  color: #A8A19C;
  font-size: 18rpx;
  line-height: 1.4;
}

/* ---------- 工具条 ---------- */
.msg-tools {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 10rpx;
}

.tool-chip {
  height: 44rpx;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 0 14rpx;
  border: 1rpx solid #EFE7E3;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #918B86;
  font-size: 19rpx;
  line-height: 42rpx;
}

.tool-chip.on {
  border-color: #F3D6D0;
  background: #FBEBEB;
  color: #C4161C;
  font-weight: 500;
}

.tool-chip.retry {
  border-color: rgba(196, 22, 28, 0.28);
  background: transparent;
  color: #C4161C;
}

.followups {
  margin-top: 8rpx;
}

.followup-label {
  margin-bottom: 8rpx;
  color: #A8A19C;
  font-size: 18rpx;
}

.followup {
  display: inline-block;
  margin: 0 8rpx 8rpx 0;
  padding: 10rpx 16rpx;
  border: 1rpx solid #F0E3DC;
  border-radius: 10rpx;
  background: #FFFFFF;
  color: #8A5D44;
  font-size: 21rpx;
  line-height: 1.4;
}

/* ---------- 推荐问 ---------- */
.suggest-card {
  margin: 6rpx 0 24rpx;
  padding: 22rpx;
  border: 1rpx solid #F2E8E3;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 22rpx rgba(94, 42, 37, 0.045);
}

.suggest-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.suggest-title {
  color: #33363A;
  font-size: 26rpx;
  font-weight: 700;
}

.suggest-sub {
  color: #B0A9A4;
  font-size: 18rpx;
}

.suggest-grid {
  display: flex;
  flex-wrap: wrap;
}

.suggest-item {
  display: flex;
  align-items: center;
  width: calc(50% - 5rpx);
  min-height: 88rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #F3E9E4;
  border-radius: 12rpx;
  background: #FAF6F3;
  color: #4F4038;
  font-size: 22rpx;
  line-height: 1.4;
}

.suggest-item:nth-child(2n) {
  margin-right: 0;
}

.suggest-mark {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #FBEBEB;
  color: #C4161C;
  font-size: 17rpx;
  line-height: 34rpx;
  text-align: center;
}

.ai-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 8rpx;
  color: #B4ADA8;
  font-size: 18rpx;
  line-height: 1.6;
}

.note-line {
  flex: none;
  width: 30rpx;
  height: 1rpx;
  margin: 0 10rpx;
  background: #E4DCD7;
}

.login-gate {
  margin: 26rpx 0 8rpx;
  padding: 42rpx 30rpx 36rpx;
  border: 1rpx solid #F0E2DB;
  border-radius: 22rpx;
  background: linear-gradient(160deg, #FFFDFB 0%, #FFF7F1 100%);
  box-shadow: 0 10rpx 26rpx rgba(94, 42, 37, 0.08);
  text-align: center;
}

.gate-badge {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 18rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: linear-gradient(145deg, #E44432, #A8111A);
  box-shadow: 0 8rpx 18rpx rgba(196, 22, 28, 0.22);
  color: #FFE7B8;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.gate-title {
  color: #26282B;
  font-size: 32rpx;
  font-weight: 700;
}

.gate-desc {
  margin-top: 10rpx;
  color: #8E918F;
  font-size: 22rpx;
  line-height: 1.7;
}

.gate-btn {
  height: 80rpx;
  margin: 24rpx 28rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  box-shadow: 0 8rpx 18rpx rgba(196, 22, 28, 0.2);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.gate-tip {
  margin-top: 14rpx;
  color: #B0A9A4;
  font-size: 18rpx;
}

.login-composer {
  flex: none;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F2EAE6;
  background: #FFFFFF;
  text-align: center;
}

.login-composer-btn {
  height: 80rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D21F24, #A8111A);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.login-composer-note {
  margin-top: 10rpx;
  color: #B0A9A4;
  font-size: 18rpx;
}

.chat-bottom {
  height: 4rpx;
}

/* ---------- 输入区 ---------- */
.composer {
  flex: none;
  padding: 14rpx 24rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F0E8E4;
  background: #FFFFFF;
  box-shadow: 0 -6rpx 20rpx rgba(94, 42, 37, 0.04);
}

.composer-box {
  display: flex;
  align-items: flex-end;
  padding: 10rpx 10rpx 10rpx 20rpx;
  border: 1rpx solid #F0E7E2;
  border-radius: 24rpx;
  background: #F8F4F1;
}

.composer-input {
  flex: 1;
  width: 0;
  min-height: 56rpx;
  max-height: 168rpx;
  padding: 8rpx 0;
  color: #33363A;
  font-size: 28rpx;
  line-height: 1.55;
}

.composer-placeholder {
  color: #B4ADA8;
  font-size: 26rpx;
}

.send-btn {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D21F24 0%, #A8111A 100%);
  box-shadow: 0 6rpx 16rpx rgba(196, 22, 28, 0.22);
}

.send-btn.disabled {
  opacity: 0.4;
  box-shadow: none;
}

.send-btn.stop-btn {
  background: #3B3E43;
  box-shadow: none;
}

.send-icon {
  width: 36rpx;
  height: 36rpx;
}

.composer-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 0;
  color: #B4ADA8;
  font-size: 18rpx;
}

.disclaimer {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
  line-height: 1.4;
}

.char-count {
  flex: none;
}

.stop-hint {
  flex: none;
  color: #C4161C;
}
