<wxs module="i18n" src="../../utils/i18n.wxs"></wxs>
<view class="ai-page">
  <view class="ai-head">
    <view class="head-row">
      <view class="ai-avatar">
        <image class="ai-avatar-img" src="/assets/icons/ai-xiaojia.png" mode="aspectFill"></image>
        <view class="avatar-dot"></view>
      </view>
      <view class="head-main">
        <view class="head-name">
          新源小贾
          <view class="online-dot"></view>
          <text class="online-text">{{i18n.t('在线', lang)}}</text>
        </view>
        <view class="head-desc">{{i18n.t('AI 网格员 · 已学习 128 条本地政策', lang)}}</view>
      </view>
      <view class="head-actions" wx:if="{{!needLogin}}">
        <view class="history-btn" bindtap="onHistory" hover-class="press">{{i18n.t('历史', lang)}}</view>
        <view class="new-chat" bindtap="onNewChat" hover-class="press">{{i18n.t('＋ 新对话', lang)}}</view>
        <view
          class="tts-btn {{ttsOn ? 'on' : ''}} {{ttsSpeaking ? 'speaking' : ''}}"
          bindtap="onToggleTts"
          hover-class="press"
        >
          <text class="tts-icon">{{ttsOn ? (ttsSpeaking ? '🔊' : '🔈') : '🔇'}}</text>
        </view>
      </view>
    </view>
    <view class="head-promise">
      <view class="promise-dot"></view>
      <text>{{i18n.t('回答附政策依据 · 查不到会直说', lang)}}</text>
    </view>
  </view>

  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollInto}}"
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onChatScroll"
  >
    <view class="chat-inner">
      <view class="date-line">
        <view class="date-text">{{i18n.t('今天 · 新源村', lang)}}</view>
      </view>

      <view class="login-gate" wx:if="{{needLogin}}">
        <view class="gate-badge">AI</view>
        <view class="gate-title">{{i18n.t('登录后使用 AI 小贾', lang)}}</view>
        <view class="gate-desc">{{i18n.t('AI 问政、政策依据和历史会话需要登录后使用。', lang)}}</view>
        <view class="gate-btn" bindtap="onGoLogin" hover-class="press">{{i18n.t('去登录', lang)}}</view>
        <view class="gate-tip">{{i18n.t('支持微信一键登录 / 手机号 + 密码', lang)}}</view>
      </view>

      <block wx:for="{{messages}}" wx:key="id">
        <view class="msg-row user-row" wx:if="{{item.role === 'user'}}">
          <view class="bubble user-bubble">
            <text class="msg-text">{{item.content}}</text>
          </view>
          <view class="msg-avatar user-avatar">{{userAvatar}}</view>
        </view>

        <view class="msg-row ai-row" wx:else>
          <view class="msg-avatar ai-msg-avatar">
            <image class="msg-avatar-img" src="/assets/icons/ai-xiaojia-face.png" mode="aspectFill"></image>
          </view>
          <view class="msg-body">
            <view class="bubble ai-bubble {{item.error ? 'error-bubble' : ''}}">
              <view class="typing" wx:if="{{item.streaming && !item.content}}">
                <view class="typing-dots">
                  <view class="typing-dot"></view>
                  <view class="typing-dot"></view>
                  <view class="typing-dot"></view>
                </view>
                <text>{{i18n.t('正在查找本地政策…', lang)}}</text>
              </view>
              <block wx:else>
                <text class="msg-text">{{item.content}}</text>
                <text class="stream-cursor" wx:if="{{item.streaming}}">▍</text>
              </block>

              <view class="stopped-note" wx:if="{{item.stopped}}">{{i18n.t('已停止生成', lang)}}</view>
              <view class="degraded-note" wx:if="{{item.degraded}}">{{i18n.t('网络波动，已切换为普通回答', lang)}}</view>

              <view class="refs" wx:if="{{item.refs.length}}">
                <view class="refs-head">
                  <view class="refs-line"></view>
                  <text>依据 · {{item.refs.length}} 条</text>
                </view>
                <view
                  class="ref-card"
                  wx:for="{{item.refs}}"
                  wx:key="id"
                  wx:for-item="ref"
                  data-route="{{ref.route}}"
                  bindtap="onRefTap"
                  hover-class="press"
                >
                  <view class="ref-type">{{ref.type === 'item' ? i18n.t('事项', lang) : i18n.t('政策', lang)}}</view>
                  <view class="ref-main">
                    <view class="ref-title line-1">{{ref.title}}</view>
                    <view class="ref-source line-1">{{ref.source}}</view>
                  </view>
                  <view class="arrow"></view>
                </view>
              </view>
            </view>

            <view class="msg-tools" wx:if="{{!item.streaming && item.question}}">
              <view
                class="tool-chip {{item.feedback === 'up' ? 'on' : ''}}"
                data-index="{{index}}"
                data-type="up"
                bindtap="onFeedback"
              >{{i18n.t('有帮助', lang)}}</view>
              <view
                class="tool-chip {{item.feedback === 'down' ? 'on' : ''}}"
                data-index="{{index}}"
                data-type="down"
                bindtap="onFeedback"
              >{{i18n.t('没帮助', lang)}}</view>
              <view class="tool-chip" data-text="{{item.content}}" bindtap="onCopy">{{i18n.t('复制', lang)}}</view>
              <view
                class="tool-chip {{ttsSpeaking && ttsIndex === index ? 'on' : ''}}"
                data-index="{{index}}"
                bindtap="onSpeakMessage"
              >{{ttsSpeaking && ttsIndex === index ? (lang === 'ko' ? '정지' : '停止') : (lang === 'ko' ? '읽기' : '朗读')}}</view>
              <view
                class="tool-chip"
                wx:if="{{index === messages.length - 1 && item.question}}"
                data-index="{{index}}"
                bindtap="onRegenerate"
              >{{i18n.t('重新生成', lang)}}</view>
              <view class="tool-chip retry" wx:if="{{item.error}}" data-question="{{item.question}}" bindtap="onRetry">{{i18n.t('重试', lang)}}</view>
            </view>

            <view class="followups" wx:if="{{!item.streaming && item.followUps.length}}">
              <view class="followup-label">{{i18n.t('您可能还想问', lang)}}</view>
              <view
                class="followup"
                wx:for="{{item.followUps}}"
                wx:key="*this"
                wx:for-item="q"
                data-text="{{q}}"
                bindtap="onFollowUp"
                hover-class="press"
              >{{q}}</view>
            </view>
          </view>
        </view>
      </block>

      <view class="suggest-card" wx:if="{{!needLogin && messages.length === 1 && suggestions.length}}">
        <view class="suggest-head">
          <view class="suggest-title">{{i18n.t('您可以这样问', lang)}}</view>
          <view class="suggest-sub">{{i18n.t('点一下就能问', lang)}}</view>
        </view>
        <view class="suggest-grid">
          <view
            class="suggest-item"
            wx:for="{{suggestions}}"
            wx:key="id"
            data-text="{{item.text}}"
            bindtap="onSuggestion"
            hover-class="press"
          >
            <view class="suggest-mark">{{i18n.t('问', lang)}}</view>
            <text>{{item.text}}</text>
          </view>
        </view>
      </view>

      <view class="ai-note" wx:if="{{!needLogin}}">
        <view class="note-line"></view>
        <text>{{i18n.t('小贾会标明依据；没有依据时会直接说“没查到”', lang)}}</text>
        <view class="note-line"></view>
      </view>

      <view class="chat-bottom" id="chat-bottom"></view>
    </view>
  </scroll-view>

  <view class="scroll-bottom" wx:if="{{showScrollBottom}}" bindtap="onScrollToBottom" hover-class="press">
    <text>{{i18n.t('回到最新', lang)}}</text>
    <text class="scroll-arrow">↓</text>
  </view>

  <view class="composer" wx:if="{{!needLogin}}">
    <view class="composer-box">
      <textarea
        class="composer-input"
        value="{{input}}"
        placeholder="{{i18n.t('输入您想问的事，如：医保怎么缴', lang)}}"
        placeholder-class="composer-placeholder"
        maxlength="200"
        auto-height
        show-confirm-bar="{{false}}"
        confirm-type="send"
        cursor-spacing="24"
        bindinput="onInput"
        bindconfirm="onSend"
      ></textarea>
      <view
        class="send-btn {{streaming ? 'stop-btn' : ''}} {{canSend || streaming ? '' : 'disabled'}}"
        bindtap="onSendOrStop"
        hover-class="press"
      >
        <image
          class="send-icon"
          src="{{streaming ? '/assets/icons/icon-stop.png' : '/assets/icons/icon-send.png'}}"
          mode="aspectFit"
        ></image>
      </view>
    </view>
    <view class="composer-foot">
      <text class="disclaimer">{{disclaimer}}</text>
      <text class="char-count" wx:if="{{!streaming}}">{{input.length}}/200</text>
      <text class="stop-hint" wx:else>{{i18n.t('正在回答 · 点右侧停止', lang)}}</text>
    </view>
  </view>
  <view class="login-composer" wx:else>
    <view class="login-composer-btn" bindtap="onGoLogin" hover-class="press">{{i18n.t('登录后提问', lang)}}</view>
    <view class="login-composer-note">{{i18n.t('未登录不能使用 AI 小贾', lang)}}</view>
  </view>
</view>
